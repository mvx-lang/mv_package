* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG config — show the registry base URL and (UniData) this account's deploy
* configuration: the catalog scope + store prefix that set it apart as a test or
* live environment (mv_package#34).
   SUBROUTINE MVPKG.CONFIG
   CALL MVPKG.REG(REG)
   PRINT "registry: " : REG
$IFNDEF MVX
   CALL MVPKGOS("CONF", "scope", "", SCOPE)
   CALL MVPKGOS("CONF", "prefix", "", PREFIX)
   CALL MVPKGOS("STORE", "", "", STORE)
   PRINT "catalog:  " : SCOPE
   PRINT "prefix:   " : PREFIX
   PRINT "store:    " : STORE
$ENDIF
   RETURN
