* mv_package — MVPKG subcommand: config.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG config — show the registry base URL, this account's stability policy,
* and (UniData) its deploy configuration: the catalog scope + store prefix that
* set it apart as a test or live environment (mv_package#34).
*
* MVPKG config minimum-stability [dev|alpha|beta|rc|stable]
* MVPKG config prefer-stable [on|off]   (off by default, as in Composer)
*   with a value, set it; without one, print just that setting.  The policy
*   lives in the account manifest (MVPKG.MANIFEST <3> and <4>) beside the
*   declared dependencies, because it is a property of the project, not of the
*   client — a checkout that carries its manifest carries its floor with it.
   SUBROUTINE MVPKG.CONFIG
$IFDEF MVX
   S = SENTENCE()
$ELSE
   S = @SENTENCE
$ENDIF
   * CKEY / CVAL / CWORD, not KEY / VAL / WORD: KEY is a reserved word on jBASE
   * (and the error it gives is on the NEXT statement too, so a bare "KEY" costs
   * two confusing diagnostics).  See the porting wiki.
   CKEY = OCONV(TRIM(FIELD(S, " ", 3)), "MCL")
   CVAL = TRIM(FIELD(S, " ", 4))
   IF CKEY # "" THEN
      GOSUB SETONE
      RETURN
   END

   CALL MVPKG.REG(REG)
   PRINT "registry: " : REG
   GOSUB READPOL
   PRINT "min-stability: " : PFLOOR
   PRINT "prefer-stable: " : PSWORD
$IFNDEF MVX
   CALL MVPKGOS("CONF", "scope", "", SCOPE)
   CALL MVPKGOS("CONF", "prefix", "", PREFIX)
   CALL MVPKGOS("STORE", "", "", STORE)
   PRINT "catalog:  " : SCOPE
   PRINT "prefix:   " : PREFIX
   PRINT "store:    " : STORE
$ENDIF
   RETURN

* READPOL — the stability policy as stored, with the defaults applied.  An
* unreadable floor is reported as such rather than silently becoming stable:
* the account was configured with an intent, and a typo that quietly resolves
* to the strictest setting is the kind that is never noticed.
READPOL:
   CALL MVPKGOS("MDREAD", "MVPKG.MANIFEST", "", MFR)
   PFLOOR = OCONV(TRIM(MFR<3>), "MCL")
   IF PFLOOR = "" THEN
      PFLOOR = "stable"
   END ELSE
      CALL SEMVER("RANK", PFLOOR, "", PFRANK)
      IF PFRANK = 0 THEN
         PFLOOR = PFLOOR : " (not a stability word — treated as stable)"
      END
   END
   PSWORD = "off"
   IF TRIM(MFR<4>) = "1" THEN PSWORD = "on"
   RETURN

* SETONE — apply or report ONE setting.  NOT "SETTING": that is a reserved word
* on UniData (LOCATE ... SETTING), and a label spelled with it fails to compile
* there while compiling clean on MVX.
SETONE:
   BEGIN CASE
      CASE CKEY = "minimum-stability" OR CKEY = "min-stability"
         IF CVAL = "" THEN
            GOSUB READPOL
            PRINT PFLOOR
            RETURN
         END
         CWORD = OCONV(CVAL, "MCL")
         CALL SEMVER("RANK", CWORD, "", WR)
         IF WR = 0 THEN
            PRINT "mvpkg: " : CVAL : " is not a stability — use dev, alpha, beta, rc or stable"
            RETURN
         END
         MSLOT = 3 ; MVAL = CWORD ; GOSUB WRITEPOL
         PRINT "min-stability: " : CWORD
      CASE CKEY = "prefer-stable"
         IF CVAL = "" THEN
            GOSUB READPOL
            PRINT PSWORD
            RETURN
         END
         CWORD = OCONV(CVAL, "MCL")
         BEGIN CASE
            CASE CWORD = "on" OR CWORD = "1" OR CWORD = "true"  ; MVAL = "1"
            CASE CWORD = "off" OR CWORD = "0" OR CWORD = "false" ; MVAL = "0"
            CASE 1
               PRINT "mvpkg: prefer-stable is on or off"
               RETURN
         END CASE
         MSLOT = 4 ; GOSUB WRITEPOL
         IF MVAL = "1" THEN PRINT "prefer-stable: on" ELSE PRINT "prefer-stable: off"
      CASE 1
         PRINT "mvpkg: no such setting " : CKEY
         PRINT "  settings: minimum-stability, prefer-stable"
   END CASE
   RETURN

* WRITEPOL — store one policy attribute, creating the manifest if this account
* has declared nothing yet.  A floor is worth setting BEFORE the first install.
WRITEPOL:
   CALL MVPKGOS("MDREAD", "MVPKG.MANIFEST", "", MFR)
   IF MFR = "" THEN MFR = "MVPKG-MANIFEST"
   MFR<MSLOT> = MVAL
   CALL MVPKGOS("MDWRITE", "MVPKG.MANIFEST", MFR, MERR)
   IF MERR # "" THEN PRINT "mvpkg: " : MERR
   RETURN
