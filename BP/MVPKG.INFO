*
* MVPKG info <name> — show a package's registry metadata.
   SUBROUTINE MVPKG.INFO
$IFDEF MVX
   S = SENTENCE()
$ELSE
   S = @SENTENCE
$ENDIF
   A1 = FIELD(S, " ", 3)
   IF A1 = "" THEN PRINT "usage: MVPKG info <name>" ; RETURN
   CALL MVPKG.REG(REG)
   CALL MVPKG.META(A1, "", REG, META)
   IF META = "" THEN
      PRINT A1 : ": not found in registry " : REG
      RETURN
   END
   PRINT "name:         " : META<1>
   PRINT "version:      " : META<2>
   PRINT "description:  " : META<4>
   PRINT "dependencies: " : META<5>
*  The registry returns an ABSOLUTE artifact URL, so prefixing REG glued the two
*  together ("https://mv-package.heydon.iohttps://github.com/..."). Prefix only a
*  RELATIVE one, which is what MVPKG.ONE does before it fetches -- and why install
*  worked while info misreported.
   TURL = META<3>
   IF TURL[1, 4] # "http" THEN TURL = REG : TURL
   PRINT "tarball:      " : TURL
   RETURN