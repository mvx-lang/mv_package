*
* MVPKGOS(OP, P1, P2, RESULT) — the one call the portable client makes for
* operations that are not pure MultiValue: making a directory and unpacking a
* release tar archive.  Every MV system ships its own MVPKGOS (this one is the
* MVX port); the client MVPKG never shells out directly, so it stays portable.
*
*   OP = "MKDIR"  P1 = path                 -> create P1 (and parents)
*   OP = "RMRF"   P1 = path                 -> remove P1 and its contents
*   OP = "UNTAR"  P1 = tarball  P2 = destdir -> extract P1 into P2
*   OP = "CALLC"  P1 = pkgdir   P2 = name    -> integrate a package's native
*                   contribution.  No-op on MVX: native code is a compiled
*                   subroutine library that installs as-is, not something
*                   aggregated into a shared library.  The UniData port
*                   rebuilds libu2callc.so here (see udt/MVPKGOS).
*   OP = "REBUILD"                           -> no-op on MVX (see above)
*   OP = "STORE"                             -> RESULT = global package store
*                   dir (created); download-once lives here
*   OP = "BUILD"    P1 = pkgdir              -> build a source package
*                   (BP -> CATALOG/LIB): native BUILD-PKG verb, falling back
*                   to mkpkg only for a C-extension package
*   OP = "LINK"     P1 = pkgdir              -> deploy into this account
*                   (LINK-PKG: its verbs + LIB + dependency closure)
*   OP = "LDCHECK"  P1 = pkgdir              -> RESULT = "" when the native
*                   code this package SHIPS resolves on this host, else one
*                   "<file>: <soname> not found" line per unresolved
*                   dependency.  "" also means "cannot tell" -- see LDCHECK.
*   OP = "PLATFORM"                          -> RESULT =
*                   "<system>:<os>:<arch>:<endian>", the identity the client
*                   sends the registry so it can serve the matching prebuilt
*                   binary (else the source tar).  MVX is system "mvx"; os is
*                   uname -s (linux/aix/windows — native code is OS-locked);
*                   arch is uname -m; endian is "le"/"be" (the axis for BASIC
*                   objects + data files).
*
* RESULT is returned "" on success or an error message.  On MVX these run
* through the runtime's native primitives (MKDIR/RMTREE/UNTAR/UNAME) and OSEXEC
* — argv-style, no shell — so MVPKG runs at the RESTRICTED tier with only the
* vendor permit its .mv-account declares (mkdir rmtree untar mkpkg chown ldd),
* not the whole-shell unrestricted tier; other ports may differ.
   SUBROUTINE MVPKGOS(OP, P1, P2, RESULT)
$INCLUDE MVPKG.INC PLATFORM.H
   RESULT = ""
   OP = OCONV(OP, "MCU")
   BEGIN CASE
      CASE OP = "MKDIR"
         IF MKDIR(P1) < 1 THEN RESULT = "MVPKGOS MKDIR: cannot create " : P1
      CASE OP = "RMRF"
         * P1 = path.  Remove it and its contents (a stale store checkout before
         * a fresh untar) with the native recursive-delete primitive — no shell,
         * so nothing to escape.
         IF RMTREE(P1) < 1 THEN RESULT = "MVPKGOS RMRF: cannot remove " : P1
      CASE OP = "UNTAR"
         * Extract P1 into P2 with the native UNTAR primitive: it creates P2 and,
         * when the archive is wrapped in a single top-level directory (the
         * account-shaped-package convention, e.g. git/), unwraps it so the
         * package's files land at the store root either way — no shell pipeline.
         IF UNTAR(P1, P2) # 0 THEN RESULT = "MVPKGOS UNTAR: cannot extract " : P1
      CASE OP = "CALLC"
         * MVX has no shared CallC library to aggregate — nothing to do.
      CASE OP = "REBUILD"
         * see CALLC
      CASE OP = "STORE"
         * RESULT = the global package store (created if absent) — where a
         * downloaded package's source/build lives once per system, linked into
         * each account.  $MVPKG_STORE overrides the default $HOME/.mvxpkg.
         SP = ENV("MVPKG_STORE")
         IF SP = "" THEN SP = ENV("HOME") : "/.mvxpkg"
         IF MKDIR(SP) < 1 THEN RESULT = "MVPKGOS STORE: cannot create " : SP ; RETURN
         RESULT = SP
      CASE OP = "BUILD"
         * P1 = package dir.  Build it (compile BP -> CATALOG/ verbs + LIB/
         * libraries) so LINK-PKG has something to join.  Prefer the native
         * BUILD-PKG verb: it compiles through the runtime (no shell, developer
         * privilege, no mkpkg on PATH).  A package with a C extension needs a
         * compiler; BUILD-PKG reports BUILD-PKG-NATIVE and we fall back to the
         * mkpkg shell build (which also handles *.BP fallback source dirs).
         EXECUTE 'BUILD-PKG ' : P1 CAPTURING BOUT
         IF INDEX(BOUT, "BUILD-PKG-NATIVE", 1) THEN
            * C-extension package: BUILD-PKG can't compile it, so fall back to the
            * mkpkg build, argv-style via OSEXEC (it locates BP/ and *.BP source
            * dirs itself).
            *
            * AND SAY WHETHER IT WORKED (#177).  This was `JUNK = OSEXEC(...)'
            * with the output and the status both thrown away, on the reasoning
            * that a missing build tool is the package's problem to report.  It
            * is not: nothing downstream looks at the tree either, so a build
            * that never happened reached STOREWRITE, was recorded as installed,
            * and the account was left with whatever LIB/ already held.  That is
            * the silence this issue was filed about -- the toolchain shipped
            * without mkpkg for a whole release and no install ever said so.
            MOUT = ""
            MRC = OSEXEC('mkpkg' : @FM : P1, MOUT)
            IF MRC # 0 THEN
               RESULT = "mkpkg could not build " : P1 : " (exit " : MRC : ")"
               * A NEGATIVE STATUS IS NOT THE BUILD FAILING, it is the spawn
               * being refused, and the two need different remedies: the permit
               * grant, versus the compiler.
               IF MRC < 0 THEN RESULT := " — the runtime refused to run it: is mkpkg on PATH, and does this account's permit grant it?"
               IF TRIM(MOUT) # "" THEN RESULT := CHAR(10) : CHANGE(MOUT, @AM, CHAR(10))
            END
         END ELSE
            IF INDEX(BOUT, "failed", 1) THEN RESULT = BOUT
         END
      CASE OP = "LDCHECK"
         * P1 = package dir.  See LDCHECK at the foot of this file.
$IFDEF MVX
         GOSUB LDCHECK
         RESULT = LDMISS
$ENDIF
      CASE OP = "LINK"
         * P1 = package dir.  Deploy into THIS account: LINK-PKG joins the
         * package's verbs (its VOC/) and LIB into resolution, pulling the
         * dependency closure too.
         EXECUTE 'LINK-PKG ' : P1
      CASE OP = "UNLINK"
         * P1 = package dir.  Remove it from THIS account (the inverse of LINK);
         * UNLINK-PKG refuses if another linked package still depends on it.
         EXECUTE 'UNLINK-PKG ' : P1
      CASE OP = "PLATFORM"
         * os = uname -s (native code is OS-locked); arch = uname -m; endian
         * from a two-byte dump (0201 = little, 0102 = big — the axis for
         * compiled BASIC objects + data files).
         OSN = OCONV(UNAME('s'), "MCL")
         BEGIN CASE
            CASE INDEX(OSN, "linux", 1) ; OSN = "linux"
            CASE INDEX(OSN, "aix", 1)   ; OSN = "aix"
            CASE INDEX(OSN, "sunos", 1) ; OSN = "solaris"
            CASE INDEX(OSN, "hp-ux", 1) ; OSN = "hpux"
            CASE INDEX(OSN, "darwin", 1) ; OSN = "darwin"
            CASE INDEX(OSN, "windows", 1) OR INDEX(OSN, "cygwin", 1) OR INDEX(OSN, "mingw", 1) ; OSN = "windows"
            CASE OSN = "" ; OSN = "unknown"
         END CASE
         ARCH = UNAME('m')
         IF ARCH = "" THEN ARCH = "unknown"
         ENDIAN = UNAME('e')
         RESULT = "mvx:" : OSN : ":" : ARCH : ":" : ENDIAN
      CASE OP = "MDREAD"
         * Read a record from the account master dictionary (VOC/MD) — the
         * portable home for account state (manifest / lock / installed set).
         * P1 = record id; RESULT = the record, or "" when it is not on file.
         OPEN MVMASTER TO MDF ELSE RESULT = "" ; RETURN
         READ MDR FROM MDF, P1 THEN RESULT = MDR ELSE RESULT = ""
      CASE OP = "MDWRITE"
         * P1 = record id, P2 = the record.  Persist account state as a native
         * master-dictionary record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDWRITE: cannot open " : MVMASTER ; RETURN
         WRITE P2 ON MDF, P1
      CASE OP = "MDDELETE"
         * P1 = record id.  Remove an account state record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDDELETE: cannot open " : MVMASTER ; RETURN
         DELETE MDF, P1
      CASE OP = "STOREOK"
         * RESULT = "" when the shared store is readable, else why not.  EMPTY IS
         * NOT THE SAME AS UNREACHABLE: STOREREAD answers "" to both, so MVPKG
         * list asks this before concluding "no packages installed" (#67).
         *
         * THIS SEAM DID NOT HAVE IT.  Only the udt/uv/jbase seam did, and the
         * call in MVPKG.LIST is unguarded -- so on MVX an EMPTY store printed
         *   mvpkg: MVPKGOS: unknown op STOREOK
         * where it meant to print "no packages installed".  It hid because it
         * needs an empty store to reach, and the same-named op existing on the
         * other three made the call look answered (#130).
         GOSUB STOREOPEN
         RESULT = ""
         IF NOT(STFOK) THEN RESULT = "cannot open the package store " : SF
      CASE OP = "STOREREAD"
         * Read a record from the shared SYSTEM store MVPKG.STORE — the
         * per-system inventory of installed packages (record "installed": <2>
         * names / <3> versions; "SRC.<key>": a source working-copy path).  On
         * MVX the store is a directory file inside the global store dir, opened
         * by absolute path, so every account on this host reaches the same one
         * (MVX has no Q-pointers — the shared path IS the sharing).  P1 = record
         * id; RESULT = the record, or "" when absent.
         GOSUB STOREOPEN
         RESULT = ""
         IF STFOK THEN READ SREC FROM STF, P1 THEN RESULT = SREC
      CASE OP = "STOREWRITE"
         * P1 = record id, P2 = the record.  Persist the system inventory.
         GOSUB STOREOPEN
         IF STFOK THEN WRITE P2 ON STF, P1 ELSE RESULT = "MVPKGOS STOREWRITE: cannot open MVPKG.STORE"
      CASE OP = "STOREDELETE"
         * P1 = record id.  Remove a system-inventory record.
         GOSUB STOREOPEN
         IF STFOK THEN DELETE STF, P1
      CASE OP = "CHOWN"
         * P1 = path, P2 = user.  Re-assign / repair ownership — MVX installs as
         * the invoking user (no DBA-owned global catalog to repair), so this is
         * mainly for CHANGING the operator (a new owner of the store + account),
         * which needs privilege to cross users.  Runs chown argv-style via OSEXEC,
         * so MVPKG's declared command surface must permit chown (vendor permit in
         * .mvx; see FIXPERMS).  Best-effort — captured, rc ignored.
         IF P1 # "" AND P2 # "" THEN JUNK = OSEXEC('chown' : @FM : '-R' : @FM : P2 : @FM : P1, COUT)
      CASE OP = "INCSETUP"
         * Provision the account's MVPKG.INC include + PLATFORM.H, so a managed
         * package can $INCLUDE MVPKG.INC PLATFORM.H for its platform defines.  The
         * MVX compiler resolves the include by directory layout under the account
         * (no VOC pointers on MVX), and MVX is a builtin compiler define, so
         * PLATFORM.H is comment-only here.  Idempotent — MVPKG INIT reruns it.
         AC = ENV("MVXACCOUNT") ; IF AC = "" THEN AC = "."
         INCD = AC : "/MVPKG.INC"
         IF MKDIR(INCD) < 1 THEN RESULT = "MVPKGOS INCSETUP: cannot create " : INCD ; RETURN
         PH = "* PLATFORM.H - platform compile-time defines." : CHAR(10)
         PH = PH : "* GENERATED FILE - DO NOT EDIT.  MVPKG INIT rewrites it," : CHAR(10)
         PH = PH : "* so any change made here is lost the next time it runs." : CHAR(10)
         PH = PH : "* MVX is a builtin compiler define; nothing to declare here." : CHAR(10)
         * MVMASTER names the account's master dictionary, so a managed package
         * opens it by name instead of guarding every OPEN.  VOC everywhere but
         * jBASE, which has an MD -- and naming it here is what makes that a
         * one-line difference rather than a $IFDEF at every call site.
         PH = PH : 'EQUATE MVMASTER TO "VOC"' : CHAR(10)
         * MVX spells the environment ENV(); every other MV system spells it
         * GETENV().  Declared HERE rather than behind a $IFDEF MVX in each
         * caller, because on jBASE a $DEFINE inside a FALSE $IFDEF still takes
         * effect -- so a guarded rename leaks and rewrites GETENV to a function
         * jBASE does not have.  A per-platform generated file cannot leak.
         PH = PH : "$DEFINE GETENV ENV" : CHAR(10)
         CALL MVPKG.FILE("WRITE", INCD : "/PLATFORM.H", PH, MVFOK)
         IF NOT(MVFOK) THEN RESULT = "MVPKGOS INCSETUP: cannot write " : INCD : "/PLATFORM.H"
      CASE 1
         RESULT = "MVPKGOS: unknown op ":OP
   END CASE
   RETURN
*
* STOREOPEN — open the shared system store file MVPKG.STORE, STFOK = 1 when STF
* is usable.  The store is a directory file (dir driver) inside the global store
* dir ($MVPKG_STORE or $HOME/.mvxpkg); an absolute-path OPEN reaches it from any
* account, and creating the dir is all the "provisioning" a dir file needs.
STOREOPEN:
   STFOK = 0
   SP = ENV("MVPKG_STORE")
   IF SP = "" THEN SP = ENV("HOME") : "/.mvxpkg"
   SF = SP : "/MVPKG.STORE"
   IF MKDIR(SF) < 1 THEN RETURN
   OPEN SF TO STF THEN STFOK = 1
   RETURN
$IFDEF MVX
* --- does the native code this package SHIPS resolve here? -----------------
* LDCHECK — LDMISS names every library the package's own binaries need and this
* host does not have, one "<file>: <soname>" per attribute; "" when there is
* nothing wrong OR nothing this port can tell.
*
* THE DECLARED C LIBRARIES CANNOT ANSWER THIS, which is why the preflight the
* other ports run (CLIBCHECK in MVPKG.ONE) is not what MVX needs.  A package
* declares the libraries its SOURCE links -- mvx-lang/git declares
* `libgit2.so:>=1.7,<2.8' -- and that range is SATISFIED on a host carrying
* libgit2 1.9.  The prebuilt in the artifact was linked against 1.7, and
* libgit2 breaks its ABI at every minor, so the declaration says yes and the
* library still cannot load.  Measured: SEMVER("SAT", "1.9", ">=1.7 <2.8") = 1.
*
* So ask the file, not the manifest.  This is the same question mvx's own
* installer asks of a bundled package (mvx_native_missing in
* scripts/pkgdeps.cmake, mvx#370) and for the same reason: a relocatable
* artifact is built where the host is not present, so nothing before this
* moment could have known.
*
* MVX ONLY, and not for want of generalising.  Every other port RELINKS the
* package's C on the host at install time -- UniData folds it into
* libu2callc.so (udt-callc-build, see udt/MVPKGOS CALLC), jBASE links a DEFC
* library -- so their binary artifacts carry no prebuilt whose DT_NEEDED could
* name a soname this machine lacks.  MVX installs the shipped library as-is,
* which is the whole reason this check has to exist.
*
* "" IS ALSO "I CANNOT TELL", deliberately: ldd is Linux's, there is none on
* macOS, and a permit may not grant it.  An install that cannot answer behaves
* exactly as it did before this check existed rather than refusing a package
* on an unanswered question.  The grant is in .mv-account; without it this
* check is inert, which is why the suite asserts it is granted.
LDCHECK:
   LDMISS = ""
   LDOFF = 0
* LINUX ONLY, which is where ldd and DT_NEEDED mean this.  mvx's own installer
* draws the same line in the same place and for the same reason
* (mvx_native_missing returns immediately off Linux); asking elsewhere would
* spend a spawn per file to learn nothing, and on macOS there is no ldd to ask.
*
* $MVPKG_LDCHECK=force LIFTS THE GATE, so the suite can exercise this where the
* gate would otherwise refuse to -- mvx is developed on macOS, and a check that
* can only be tested on the platform it ships to is a check nobody runs before
* shipping it.  With a stub ldd on PATH the parsing and the self-supplied filter
* below are testable anywhere; only the real reading of a real ELF object needs
* a real Linux.  It can only make this check look HARDER, never softer: forcing
* it on cannot hide a missing library, it can only invent one.
   IF OCONV(UNAME('s'), "MCL") # "linux" THEN
      IF ENV("MVPKG_LDCHECK") # "force" THEN RETURN
   END
* THE PACKAGE'S OWN LIBRARIES FIRST, as a list, because they are the answer to
* "is this soname really missing?" -- a package whose extension links a sibling
* library it ships would otherwise report its own file as absent.  ldd is run in
* a second pass so no SELECT is live while another directory is opened.
   LDD = P1 : "/LIB" ; GOSUB LDLIST ; LDLIBS = LDIDS
   LDD = P1 : "/bin" ; GOSUB LDLIST ; LDBINS = LDIDS
   LDD = P1 : "/LIB"
   FOR LDI = 1 TO DCOUNT(LDLIBS<1>, @VM)
      LDID = LDLIBS<1,LDI> ; IF LDID # "" THEN GOSUB LDFILE
   NEXT LDI
* bin/ TOO, and it is not belt-and-braces: mvx-lang/git ships the mvx-git CLI
* beside its extension, and a CLI that cannot load libgit2 is the half of that
* package a user reaches first.
   LDD = P1 : "/bin"
   FOR LDI = 1 TO DCOUNT(LDBINS<1>, @VM)
      LDID = LDBINS<1,LDI> ; IF LDID # "" THEN GOSUB LDFILE
   NEXT LDI
   RETURN

* LDLIST — LDIDS<1> = the @VM list of file names in directory LDD, empty when
* there is no such directory.  A directory IS a file on MVX (the dir driver), so
* its contents are read with OPEN and READNEXT and no shell is involved.
LDLIST:
   LDIDS = ""
   OPEN LDD TO LDF ELSE RETURN
   SELECT LDF
   LOOP
      READNEXT LDNM ELSE EXIT
      IF LDNM # "" THEN LDIDS<1,-1> = LDNM
   REPEAT
   RETURN

* LDFILE — add to LDMISS every soname LDD/LDID needs and cannot find.
*
* THE TEXT, NOT THE EXIT STATUS.  ldd exits 0 on a binary with missing
* libraries and non-zero on something that is not an ELF object at all, so the
* status answers a different question than the one being asked; an empty
* capture is the only thing that means "no answer" (no ldd here, or no permit
* for it) and that returns silently.
LDFILE:
   IF LDOFF THEN RETURN
   LDOUT = ""
   LDRC = OSEXEC('ldd' : @FM : LDD : "/" : LDID, LDOUT)
* ONE REFUSAL, NOT ONE PER FILE.  A negative status is the runtime declining to
* spawn ldd at all -- no permit grant for it -- and that answer will not change
* for the next thirty files in the tree.  It prints its own explanation, which
* names the grant that is missing, so the install says why the check is off
* exactly once instead of burying it in a wall of identical lines.
   IF LDRC < 0 THEN LDOFF = 1 ; RETURN
   IF TRIM(LDOUT) = "" THEN RETURN
   FOR LDJ = 1 TO DCOUNT(LDOUT, @AM)
      LDLN = LDOUT<LDJ>
      LDP = INDEX(LDLN, "=> not found", 1)
      IF LDP > 0 THEN
         * ldd indents with a TAB and TRIM only takes spaces off.
         LDSO = TRIM(CHANGE(LDLN[1, LDP - 1], CHAR(9), " "))
         IF LDSO # "" THEN
            LOCATE(LDSO, LDLIBS, 1; LDPOS) ELSE LDMISS<-1> = LDID : ": " : LDSO
         END
      END
   NEXT LDJ
   RETURN
$ENDIF
