*
* MVPKGOS(OP, P1, P2, RESULT) — the one call the portable client makes for
* operations that are not pure MultiValue: making a directory and unpacking a
* release tar archive.  Every MV system ships its own MVPKGOS (this one is the
* MVX port); the client MVPKG never shells out directly, so it stays portable.
*
*   OP = "MKDIR"  P1 = path                 -> create P1 (and parents)
*   OP = "UNTAR"  P1 = tarball  P2 = destdir -> extract P1 into P2
*   OP = "CALLC"  P1 = pkgdir   P2 = name    -> integrate a package's native
*                   contribution.  No-op on MVX: native code is a compiled
*                   subroutine library that installs as-is, not something
*                   aggregated into a shared library.  The UniData port
*                   rebuilds libu2callc.so here (see udt/MVPKGOS).
*   OP = "REBUILD"                           -> no-op on MVX (see above)
*   OP = "STORE"                             -> RESULT = global package store
*                   dir (created); download-once lives here
*   OP = "BUILD"    P1 = pkgdir              -> build a source package (mkpkg:
*                   BP -> CATALOG/LIB) — the MVX "globally catalog" step
*   OP = "LINK"     P1 = pkgdir              -> deploy into this account
*                   (LINK-PKG: its verbs + LIB + dependency closure)
*   OP = "PLATFORM"                          -> RESULT =
*                   "<system>:<os>:<arch>:<endian>", the identity the client
*                   sends the registry so it can serve the matching prebuilt
*                   binary (else the source tar).  MVX is system "mvx"; os is
*                   uname -s (linux/aix/windows — native code is OS-locked);
*                   arch is uname -m; endian is "le"/"be" (the axis for BASIC
*                   objects + data files).
*
* RESULT is returned "" on success or an error message.  On MVX these run
* through EXECUTE "!...", so the caller needs the unrestricted privilege tier
* (installing software is inherently privileged); other ports may differ.
   SUBROUTINE MVPKGOS(OP, P1, P2, RESULT)
   RESULT = ""
   OP = OCONV(OP, "MCU")
   BEGIN CASE
      CASE OP = "MKDIR"
         EXECUTE '!mkdir -p "':P1:'"'
      CASE OP = "UNTAR"
         EXECUTE '!mkdir -p "':P2:'" && tar -xzf "':P1:'" -C "':P2:'"'
      CASE OP = "CALLC"
         * MVX has no shared CallC library to aggregate — nothing to do.
      CASE OP = "REBUILD"
         * see CALLC
      CASE OP = "STORE"
         * RESULT = the global package store (created if absent) — where a
         * downloaded package's source/build lives once per system, linked into
         * each account.  $MVPKG_STORE overrides the default $HOME/.mvxpkg.
         SP = ENV("MVPKG_STORE")
         IF SP = "" THEN SP = ENV("HOME") : "/.mvxpkg"
         EXECUTE '!mkdir -p "':SP:'"'
         RESULT = SP
      CASE OP = "BUILD"
         * P1 = package dir.  Build it (compile BP -> CATALOG/ verbs + LIB/
         * lib) so LINK-PKG has something to join — the MVX "globally catalog"
         * step.  Only a source package (has BP/) needs it; a binary release
         * ships CATALOG/LIB already, so mkpkg is skipped when there is no BP.
         EXECUTE '!test -d "':P1:'/BP" && mkpkg "':P1:'" || true'
      CASE OP = "LINK"
         * P1 = package dir.  Deploy into THIS account: LINK-PKG joins the
         * package's verbs (its VOC/) and LIB into resolution, pulling the
         * dependency closure too.
         EXECUTE 'LINK-PKG ' : P1
      CASE OP = "PLATFORM"
         * os = uname -s (native code is OS-locked); arch = uname -m; endian
         * from a two-byte dump (0201 = little, 0102 = big — the axis for
         * compiled BASIC objects + data files).
         EXECUTE '!uname -s' CAPTURING OSN
         OSN = OCONV(TRIM(CONVERT(@AM:@FM:CHAR(10):CHAR(13), "    ", OSN)), "MCL")
         BEGIN CASE
            CASE INDEX(OSN, "linux", 1) ; OSN = "linux"
            CASE INDEX(OSN, "aix", 1)   ; OSN = "aix"
            CASE INDEX(OSN, "sunos", 1) ; OSN = "solaris"
            CASE INDEX(OSN, "hp-ux", 1) ; OSN = "hpux"
            CASE INDEX(OSN, "darwin", 1) ; OSN = "darwin"
            CASE INDEX(OSN, "windows", 1) OR INDEX(OSN, "cygwin", 1) OR INDEX(OSN, "mingw", 1) ; OSN = "windows"
            CASE OSN = "" ; OSN = "unknown"
         END CASE
         EXECUTE '!uname -m' CAPTURING ARCH
         ARCH = TRIM(CONVERT(@AM:@FM:CHAR(10):CHAR(13), "    ", ARCH))
         IF ARCH = "" THEN ARCH = "unknown"
         EXECUTE "!printf '\1\2' | od -An -tx2 | tr -d ' '" CAPTURING EW
         EW = CONVERT(@AM:@FM:CHAR(10):CHAR(13), "    ", EW)
         IF INDEX(EW, "0102", 1) THEN ENDIAN = "be" ELSE ENDIAN = "le"
         RESULT = "mvx:" : OSN : ":" : ARCH : ":" : ENDIAN
      CASE 1
         RESULT = "MVPKGOS: unknown op ":OP
   END CASE
   RETURN