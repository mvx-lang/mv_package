*
* MVPKGOS(OP, P1, P2, RESULT) — the one call the portable client makes for
* operations that are not pure MultiValue: making a directory and unpacking a
* release tar archive.  Every MV system ships its own MVPKGOS (this one is the
* MVX port); the client MVPKG never shells out directly, so it stays portable.
*
*   OP = "MKDIR"  P1 = path                 -> create P1 (and parents)
*   OP = "RMRF"   P1 = path                 -> remove P1 and its contents
*   OP = "UNTAR"  P1 = tarball  P2 = destdir -> extract P1 into P2
*   OP = "CALLC"  P1 = pkgdir   P2 = name    -> integrate a package's native
*                   contribution.  No-op on MVX: native code is a compiled
*                   subroutine library that installs as-is, not something
*                   aggregated into a shared library.  The UniData port
*                   rebuilds libu2callc.so here (see udt/MVPKGOS).
*   OP = "REBUILD"                           -> no-op on MVX (see above)
*   OP = "STORE"                             -> RESULT = global package store
*                   dir (created); download-once lives here
*   OP = "BUILD"    P1 = pkgdir              -> build a source package
*                   (BP -> CATALOG/LIB): native BUILD-PKG verb, falling back
*                   to mkpkg only for a C-extension package
*   OP = "LINK"     P1 = pkgdir              -> deploy into this account
*                   (LINK-PKG: its verbs + LIB + dependency closure)
*   OP = "PLATFORM"                          -> RESULT =
*                   "<system>:<os>:<arch>:<endian>", the identity the client
*                   sends the registry so it can serve the matching prebuilt
*                   binary (else the source tar).  MVX is system "mvx"; os is
*                   uname -s (linux/aix/windows — native code is OS-locked);
*                   arch is uname -m; endian is "le"/"be" (the axis for BASIC
*                   objects + data files).
*
* RESULT is returned "" on success or an error message.  On MVX these run
* through the runtime's native primitives (MKDIR/RMTREE/UNTAR/UNAME) and OSEXEC
* — argv-style, no shell — so MVPKG runs at the RESTRICTED tier with only the
* vendor permit its .mvx declares (mkdir rmtree untar mkpkg chown), not the
* whole-shell unrestricted tier; other ports may differ.
   SUBROUTINE MVPKGOS(OP, P1, P2, RESULT)
$INCLUDE MVPKG.INC PLATFORM.H
   RESULT = ""
   OP = OCONV(OP, "MCU")
   BEGIN CASE
      CASE OP = "MKDIR"
         IF MKDIR(P1) < 1 THEN RESULT = "MVPKGOS MKDIR: cannot create " : P1
      CASE OP = "RMRF"
         * P1 = path.  Remove it and its contents (a stale store checkout before
         * a fresh untar) with the native recursive-delete primitive — no shell,
         * so nothing to escape.
         IF RMTREE(P1) < 1 THEN RESULT = "MVPKGOS RMRF: cannot remove " : P1
      CASE OP = "UNTAR"
         * Extract P1 into P2 with the native UNTAR primitive: it creates P2 and,
         * when the archive is wrapped in a single top-level directory (the
         * account-shaped-package convention, e.g. git/), unwraps it so the
         * package's files land at the store root either way — no shell pipeline.
         IF UNTAR(P1, P2) # 0 THEN RESULT = "MVPKGOS UNTAR: cannot extract " : P1
      CASE OP = "CALLC"
         * MVX has no shared CallC library to aggregate — nothing to do.
      CASE OP = "REBUILD"
         * see CALLC
      CASE OP = "STORE"
         * RESULT = the global package store (created if absent) — where a
         * downloaded package's source/build lives once per system, linked into
         * each account.  $MVPKG_STORE overrides the default $HOME/.mvxpkg.
         SP = ENV("MVPKG_STORE")
         IF SP = "" THEN SP = ENV("HOME") : "/.mvxpkg"
         IF MKDIR(SP) < 1 THEN RESULT = "MVPKGOS STORE: cannot create " : SP ; RETURN
         RESULT = SP
      CASE OP = "BUILD"
         * P1 = package dir.  Build it (compile BP -> CATALOG/ verbs + LIB/
         * libraries) so LINK-PKG has something to join.  Prefer the native
         * BUILD-PKG verb: it compiles through the runtime (no shell, developer
         * privilege, no mkpkg on PATH).  A package with a C extension needs a
         * compiler; BUILD-PKG reports BUILD-PKG-NATIVE and we fall back to the
         * mkpkg shell build (which also handles *.BP fallback source dirs).
         EXECUTE 'BUILD-PKG ' : P1 CAPTURING BOUT
         IF INDEX(BOUT, "BUILD-PKG-NATIVE", 1) THEN
            * C-extension package: BUILD-PKG can't compile it, so fall back to the
            * mkpkg build, argv-style via OSEXEC (it locates BP/ and *.BP source
            * dirs itself).  Best-effort — a missing build tool is the package's
            * problem to report, not the seam's.
            JUNK = OSEXEC('mkpkg' : @FM : P1, MOUT)
         END ELSE
            IF INDEX(BOUT, "failed", 1) THEN RESULT = BOUT
         END
      CASE OP = "LINK"
         * P1 = package dir.  Deploy into THIS account: LINK-PKG joins the
         * package's verbs (its VOC/) and LIB into resolution, pulling the
         * dependency closure too.
         EXECUTE 'LINK-PKG ' : P1
      CASE OP = "UNLINK"
         * P1 = package dir.  Remove it from THIS account (the inverse of LINK);
         * UNLINK-PKG refuses if another linked package still depends on it.
         EXECUTE 'UNLINK-PKG ' : P1
      CASE OP = "PLATFORM"
         * os = uname -s (native code is OS-locked); arch = uname -m; endian
         * from a two-byte dump (0201 = little, 0102 = big — the axis for
         * compiled BASIC objects + data files).
         OSN = OCONV(UNAME('s'), "MCL")
         BEGIN CASE
            CASE INDEX(OSN, "linux", 1) ; OSN = "linux"
            CASE INDEX(OSN, "aix", 1)   ; OSN = "aix"
            CASE INDEX(OSN, "sunos", 1) ; OSN = "solaris"
            CASE INDEX(OSN, "hp-ux", 1) ; OSN = "hpux"
            CASE INDEX(OSN, "darwin", 1) ; OSN = "darwin"
            CASE INDEX(OSN, "windows", 1) OR INDEX(OSN, "cygwin", 1) OR INDEX(OSN, "mingw", 1) ; OSN = "windows"
            CASE OSN = "" ; OSN = "unknown"
         END CASE
         ARCH = UNAME('m')
         IF ARCH = "" THEN ARCH = "unknown"
         ENDIAN = UNAME('e')
         RESULT = "mvx:" : OSN : ":" : ARCH : ":" : ENDIAN
      CASE OP = "MDREAD"
         * Read a record from the account master dictionary (VOC/MD) — the
         * portable home for account state (manifest / lock / installed set).
         * P1 = record id; RESULT = the record, or "" when it is not on file.
         OPEN MVMASTER TO MDF ELSE RESULT = "" ; RETURN
         READ MDR FROM MDF, P1 THEN RESULT = MDR ELSE RESULT = ""
      CASE OP = "MDWRITE"
         * P1 = record id, P2 = the record.  Persist account state as a native
         * master-dictionary record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDWRITE: cannot open " : MVMASTER ; RETURN
         WRITE P2 ON MDF, P1
      CASE OP = "MDDELETE"
         * P1 = record id.  Remove an account state record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDDELETE: cannot open " : MVMASTER ; RETURN
         DELETE MDF, P1
      CASE OP = "STOREREAD"
         * Read a record from the shared SYSTEM store MVPKG.STORE — the
         * per-system inventory of installed packages (record "installed": <2>
         * names / <3> versions; "SRC.<key>": a source working-copy path).  On
         * MVX the store is a directory file inside the global store dir, opened
         * by absolute path, so every account on this host reaches the same one
         * (MVX has no Q-pointers — the shared path IS the sharing).  P1 = record
         * id; RESULT = the record, or "" when absent.
         GOSUB STOREOPEN
         RESULT = ""
         IF STFOK THEN READ SREC FROM STF, P1 THEN RESULT = SREC
      CASE OP = "STOREWRITE"
         * P1 = record id, P2 = the record.  Persist the system inventory.
         GOSUB STOREOPEN
         IF STFOK THEN WRITE P2 ON STF, P1 ELSE RESULT = "MVPKGOS STOREWRITE: cannot open MVPKG.STORE"
      CASE OP = "STOREDELETE"
         * P1 = record id.  Remove a system-inventory record.
         GOSUB STOREOPEN
         IF STFOK THEN DELETE STF, P1
      CASE OP = "CHOWN"
         * P1 = path, P2 = user.  Re-assign / repair ownership — MVX installs as
         * the invoking user (no DBA-owned global catalog to repair), so this is
         * mainly for CHANGING the operator (a new owner of the store + account),
         * which needs privilege to cross users.  Runs chown argv-style via OSEXEC,
         * so MVPKG's declared command surface must permit chown (vendor permit in
         * .mvx; see FIXPERMS).  Best-effort — captured, rc ignored.
         IF P1 # "" AND P2 # "" THEN JUNK = OSEXEC('chown' : @FM : '-R' : @FM : P2 : @FM : P1, COUT)
      CASE OP = "INCSETUP"
         * Provision the account's MVPKG.INC include + PLATFORM.H, so a managed
         * package can $INCLUDE MVPKG.INC PLATFORM.H for its platform defines.  The
         * MVX compiler resolves the include by directory layout under the account
         * (no VOC pointers on MVX), and MVX is a builtin compiler define, so
         * PLATFORM.H is comment-only here.  Idempotent — MVPKG INIT reruns it.
         AC = ENV("MVXACCOUNT") ; IF AC = "" THEN AC = "."
         INCD = AC : "/MVPKG.INC"
         IF MKDIR(INCD) < 1 THEN RESULT = "MVPKGOS INCSETUP: cannot create " : INCD ; RETURN
         PH = "* PLATFORM.H - platform compile-time defines." : CHAR(10)
         PH = PH : "* MVX is a builtin compiler define; nothing to declare here." : CHAR(10)
         * MVMASTER names the account's master dictionary, so a managed package
         * opens it by name instead of guarding every OPEN.  VOC everywhere but
         * jBASE, which has an MD -- and naming it here is what makes that a
         * one-line difference rather than a $IFDEF at every call site.
         PH = PH : 'EQUATE MVMASTER TO "VOC"' : CHAR(10)
         * MVX spells the environment ENV(); every other MV system spells it
         * GETENV().  Declared HERE rather than behind a $IFDEF MVX in each
         * caller, because on jBASE a $DEFINE inside a FALSE $IFDEF still takes
         * effect -- so a guarded rename leaks and rewrites GETENV to a function
         * jBASE does not have.  A per-platform generated file cannot leak.
         PH = PH : "$DEFINE GETENV ENV" : CHAR(10)
         CALL MVPKG.FILE("WRITE", INCD : "/PLATFORM.H", PH, MVFOK)
         IF NOT(MVFOK) THEN RESULT = "MVPKGOS INCSETUP: cannot write " : INCD : "/PLATFORM.H"
      CASE 1
         RESULT = "MVPKGOS: unknown op ":OP
   END CASE
   RETURN
*
* STOREOPEN — open the shared system store file MVPKG.STORE, STFOK = 1 when STF
* is usable.  The store is a directory file (dir driver) inside the global store
* dir ($MVPKG_STORE or $HOME/.mvxpkg); an absolute-path OPEN reaches it from any
* account, and creating the dir is all the "provisioning" a dir file needs.
STOREOPEN:
   STFOK = 0
   SP = ENV("MVPKG_STORE")
   IF SP = "" THEN SP = ENV("HOME") : "/.mvxpkg"
   SF = SP : "/MVPKG.STORE"
   IF MKDIR(SF) < 1 THEN RETURN
   OPEN SF TO STF THEN STFOK = 1
   RETURN