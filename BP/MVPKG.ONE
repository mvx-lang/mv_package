* mv_package — MVPKG helper: install one already-resolved package.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG.ONE(META, REG, RESULT) — install the single package described by META (as
* returned by MVPKG.META).  Two tiers.  GLOBAL (once per system): download the
* release into the store, build/catalog its code, record it in the system store
* inventory.  ACCOUNT (every run): deploy the verbs + files into the current
* account.  So `MVPKG install` rerun in another account downloads nothing — it
* just deploys the package up.
*
* RESULT is "" on success, else a short reason — the caller must NOT record the
* package as installed when it is non-empty (a failed install written to the lock
* looks done on retry and is silently skipped).
*
* The download, the store inventory, --source and the OS-C-library preflight are
* shared; only the two deploy STEPS differ by platform and are $IFDEF'd: MVX
* builds + links the whole package (BUILD-PKG / LINK-PKG through the seam), while
* UniData compiles+globally-catalogs the code and deploys per-account VOC verb
* pointers + declared files (the mvpkg.json deploy block, walked by MVPKGDEP).
   SUBROUTINE MVPKG.ONE(META, REG, RESULT)
$IFNDEF MVX
   DEFFUN HTTPGETFILE(A, B) CALLING "*MVPKG.HTTPGETFILE"
$ENDIF
   RESULT = ""
   CALL MVPKGOS("STORE", "", "", STORE)
   * Never act on empty metadata: a blank name would make DEST the store ROOT,
   * so a later rm/untar would target the whole store.  Callers should have
   * caught a registry miss (MVPKG.META returns "" for one), but guard here too.
   IF TRIM(META<1>) = "" THEN RESULT = "empty package metadata" ; PRINT "mvpkg: " : RESULT : " — skipping" ; RETURN
   PKGKEY = CHANGE(META<1>, "/", "_")
$IFNDEF MVX
   * Preflight the OS C libraries the package declares (META<9>): if any are
   * absent, stop with a clear message BEFORE the CallC fold hits a cryptic
   * linker error.  (MVX links each package's LIB self-contained at build time,
   * so it has no shared CallC fold to preflight.)
   GOSUB CLIBCHECK
   IF CLIBMISS # "" THEN
      RESULT = "missing OS C libraries: " : TRIM(CLIBMISS)
      PRINT META<1> : ": needs OS C libraries not found: " : TRIM(CLIBMISS)
      PRINT "  install the OS package(s) providing them, then re-run."
      RETURN
   END
$ENDIF
   * --source: build + deploy directly from a git working copy (its path in
   * META<20>) through the SAME declarative path as a binary install.  No
   * download, no store inventory (MVPKG install --source records the working
   * copy), and no package script.
   SRCDIR = TRIM(META<20>)
   IF SRCDIR # "" THEN
      DEST = SRCDIR
      CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      GOSUB BUILDGLOBAL
      GOSUB DEPLOYACCT
      RETURN
   END
   DEST = STORE : "/" : PKGKEY
   * is this package already in the SYSTEM store at this version?  MVPKG.STORE
   * "installed" is the per-system inventory (<2> names / <3> parallel versions)
   * of everything downloaded + built on this machine.
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   GINST = 0
   LOCATE(META<1>, SREC, 2; SPOS) THEN
      IF TRIM(SREC<3,SPOS>) = META<2> THEN GINST = 1
   END
   IF GINST = 0 THEN
      TMP = "/tmp/mvpkg_" : PKGKEY : ".tar.gz"
      PRINT "fetching " : META<1> : " " : META<2> : " ..."
      * registry-hosted (relative) or an external http(s) URL (a binary-only
      * package served from a vendor site or GitHub) — absolute is used as-is.
      TURL = META<3>
      IF TURL[1, 4] # "http" THEN TURL = REG : TURL
      ST = HTTPGETFILE(TURL, TMP)
      IF ST < 200 OR ST >= 300 THEN RESULT = "download failed (status " : ST : ")" ; PRINT RESULT ; RETURN
      CALL MVPKGOS("RMRF", DEST, "", ERR)
      CALL MVPKGOS("UNTAR", TMP, DEST, ERR)
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      EXECUTE '!rm -f "' : TMP : '"'
      CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
      * A failed native fold must abort BEFORE cataloging — otherwise the
      * package's verbs get cataloged over working ones with no backend behind
      * them.  The store inventory is not written yet, so the package is simply
      * left uninstalled; fix the toolchain and re-run.
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      GOSUB BUILDGLOBAL
      * record it in the system inventory (add, or update its version)
      CALL MVPKGOS("STOREREAD", "installed", "", SREC)
      IF SREC = "" THEN SREC = "MVPKG-STORE"
      LOCATE(META<1>, SREC, 2; SPOS) THEN
         SREC<3,SPOS> = META<2>
      END ELSE
         SAN = DCOUNT(SREC<2>, @VM) + 1
         SREC<2,SAN> = META<1>
         SREC<3,SAN> = META<2>
      END
      CALL MVPKGOS("STOREWRITE", "installed", SREC, SERR)
      IF SERR # "" THEN PRINT "mvpkg: " : SERR
      PRINT "installed " : META<1> : " " : META<2> : " (built + cataloged)"
   END ELSE
      PRINT META<1> : " " : META<2> : " already installed — deploying here"
   END
   GOSUB DEPLOYACCT
   RETURN

* --- GLOBAL: build/catalog the package's code (once per system) -------------
* MVX builds the whole package; UniData compiles + globally catalogs BP and any
* fallback source dirs the deploy block names (walked by MVPKGDEP/PARSEDEPLOY).
BUILDGLOBAL:
$IFDEF MVX
   CALL MVPKGOS("BUILD", DEST, "", ERR) ; IF ERR # "" THEN PRINT ERR
$ELSE
   * #34: a "local" (test) account catalogs into its OWN account at deploy time
   * (DEPLOYACCT), never system-wide — so it skips this shared global build.  The
   * download + store inventory still happen once per system either way.
   CALL MVPKGOS("CONF", "scope", "", MSCOPE)
   IF MSCOPE = "local" THEN RETURN
   GOSUB PARSEDEPLOY
   PRINT "cataloging " : META<1> : " ..."
   CALL MVPKGOS("CATALOG", DEST, "BP", ERR) ; IF ERR # "" THEN PRINT ERR
   * fallback dirs: catalog each only when its programs aren't already there.
   NF = DCOUNT(DFALL, " ")
   FOR I = 1 TO NF
      PR = FIELD(DFALL, " ", I)
      FBD = FIELD(PR, ":", 2)
      IF FBD # "" THEN CALL MVPKGOS("CATIFNEW", DEST, FBD, ERR)
   NEXT I
$ENDIF
   RETURN

* --- ACCOUNT: deploy into the current account ------------------------------
* MVX links the whole package (its verbs + LIB + dependency closure); UniData
* deploys the mvpkg.json verbs as per-account VOC pointers and creates the
* declared account files.
DEPLOYACCT:
$IFDEF MVX
   CALL MVPKGOS("LINK", DEST, "", ERR) ; IF ERR # "" THEN PRINT ERR
   PRINT "linked " : META<1> : " into this account"
$ELSE
   GOSUB PARSEDEPLOY
   CALL MVPKGOS("CONF", "scope", "", MSCOPE)
   IF MSCOPE = "local" THEN
      * #34 local scope: catalog the package INTO THIS ACCOUNT (CATALOG ... LOCAL,
      * driven by MVPKGOS) — global build was skipped, and a LOCAL catalog also
      * registers each program as a verb here, so no separate VOC-pointer step.
      PRINT "cataloging " : META<1> : " (local) ..."
      CALL MVPKGOS("CATALOG", DEST, "BP", ERR) ; IF ERR # "" THEN PRINT ERR
      NF = DCOUNT(DFALL, " ")
      FOR I = 1 TO NF
         PR = FIELD(DFALL, " ", I) ; FBD = FIELD(PR, ":", 2)
         IF FBD # "" THEN CALL MVPKGOS("CATIFNEW", DEST, FBD, ERR)
      NEXT I
   END ELSE
      * global scope: the code is already globally cataloged; make each verb
      * typeable in this account with a VOC pointer.
      NV = DCOUNT(DVERBS, " ")
      FOR I = 1 TO NV
         V = FIELD(DVERBS, " ", I)
         IF V # "" THEN CALL MVPKGOS("VERB", V, "", ERR) ; IF ERR # "" THEN PRINT ERR
      NEXT I
   END
   NFI = DCOUNT(DFILES, " ")
   FOR I = 1 TO NFI
      FT = FIELD(DFILES, " ", I)
      IF FT # "" THEN
         FNM = FIELD(FT, ":", 1) ; FTY = FIELD(FT, ":", 2)
         CALL MVPKGOS("MKFILE", FNM, FTY, ERR)
      END
   NEXT I
   PRINT "deployed " : META<1> : " into this account"
$ENDIF
   RETURN

$IFNDEF MVX
* --- flatten the mvpkg.json "deploy" block in BASIC (no shell/python) -------
* MVPKGDEP walks the nested block (the flat JSON seam only reads flat strings),
* yielding space-separated DVERBS, DFILES ("name:type"), DFALL ("dep:dir").
PARSEDEPLOY:
   OSREAD MJ FROM DEST : "/mvpkg.json" ELSE MJ = ""
   CALL MVPKGDEP(MJ, DVERBS, DFILES, DFALL)
   RETURN

* --- preflight declared OS C libraries -------------------------------------
* CLIBCHECK — a package declares in its mvpkg.json the OS C libraries its CallC
* links (META<9>, space-separated).  Each entry is one of:
*   libcurl.so.4                     an exact soname
*   libgit2.so.1.7|libgit2.so.1.9    alternatives — ANY present satisfies it
*   libgit2.so:>=1.7,<2.8            a base soname + a SEMVER range over the
*                                    version suffix (libgit2 churns its soname by
*                                    distro: 1.7 on EPEL, 1.9 upstream)
* The requirement is met if the cache has a match; CLIBMISS collects any entry
* that has none, so the install stops with a clear message rather than a cryptic
* linker failure deep in the fold.
CLIBCHECK:
   CLIBMISS = ""
   CLIBS = TRIM(META<9>)
   IF CLIBS = "" THEN RETURN
   TMPF = "/tmp/mvpkg_ldc_" : @USERNO
   EXECUTE '!ldconfig -p > "' : TMPF : '" 2>/dev/null'
   OSREAD LDC FROM TMPF ELSE LDC = ""
   EXECUTE '!rm -f "' : TMPF : '"'
   NLC = DCOUNT(LDC, CHAR(10))
   FOR CI = 1 TO DCOUNT(CLIBS, " ")
      LB = FIELD(CLIBS, " ", CI)
      IF LB # "" THEN
         HIT = 0
         COLON = INDEX(LB, ":", 1)
         IF COLON > 0 THEN
            SOBASE = LB[1, COLON - 1]
            CONS = CHANGE(LB[COLON + 1, LEN(LB)], ",", " ")
            GOSUB CLIBRANGE
         END ELSE
            FOR AI = 1 TO DCOUNT(LB, "|")
               ALT = FIELD(LB, "|", AI)
               IF ALT # "" AND INDEX(LDC, ALT, 1) > 0 THEN HIT = 1
            NEXT AI
         END
         IF HIT = 0 THEN CLIBMISS := LB : " "
      END
   NEXT CI
   RETURN

* CLIBRANGE — is any installed "<SOBASE>.<version>" soname satisfying CONS (a
* space-separated SEMVER range)?  Scan ldconfig lines for SOBASE., pull the
* version suffix, and test it with the same SEMVER used for package constraints.
CLIBRANGE:
   HIT = 0
   FOR LI = 1 TO NLC
      LNL = FIELD(LDC, CHAR(10), LI)
      P = INDEX(LNL, SOBASE : ".", 1)
      IF P > 0 THEN
         VS = LNL[P + LEN(SOBASE) + 1, LEN(LNL)]
         VER = ""
         DONEV = 0
         FOR VI = 1 TO LEN(VS)
            C = VS[VI, 1]
            IF DONEV = 0 THEN
               IF C = " " OR C = "(" OR C = CHAR(9) THEN DONEV = 1 ELSE VER := C
            END
         NEXT VI
         IF VER # "" THEN
            CALL SEMVER("SAT", VER, CONS, SR)
            IF SR = 1 THEN HIT = 1
         END
      END
   NEXT LI
   RETURN
$ENDIF
