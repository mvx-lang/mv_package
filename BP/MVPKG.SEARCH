* mv_package — MVPKG subcommand: search.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG search <term> — list packages whose name or description matches.  The
* registry's /search returns an array of {name,version,description} objects; the
* "packages" association in the spec decodes it into three parallel multivalued
* attributes (R<1>=names, R<2>=versions, R<3>=descriptions).  HTTP/JSON/MAPFIELD
* are MVX intrinsics; UniData reaches them as the cataloged seam functions, so
* declare those only off MVX.  The output format mask is the other platform diff.
   SUBROUTINE MVPKG.SEARCH
   $INCLUDE MVPKG.INC PLATFORM.H
$IFDEF MVX
   S = SENTENCE()
$ENDIF
* jBASE HAS NO `DEFFUN ... CALLING`.  That clause is how U2 points a local name
* at a cataloged one; jBASE resolves a DEFFUN by NAME against the catalog, and
* the names are already there because mvpkg's dependencies catalog them.
*
* FLAT GUARDS, one per platform: an $IFDEF nested inside an $ELSE compiles on
* UniData and FAILS on UniVerse, which is what this block used to be.
$IFDEF JBASE
   DEFFUN HTTPGET(A)
   DEFFUN JSONDECODE(A, B)
   DEFFUN MAPFIELD(A, B, C, D, E)
   S = @SENTENCE
$ENDIF
$IFDEF UDT
   DEFFUN HTTPGET(A) CALLING "*MVPKG.HTTPGET"
   DEFFUN JSONDECODE(A, B) CALLING "*MVPKG.JSONDECODE"
   DEFFUN MAPFIELD(A, B, C, D, E) CALLING "*MVPKG.MAPFIELD"
   S = @SENTENCE
$ENDIF
$IFDEF UV
* NO "*" HERE, unlike the UniData arm above.  A leading star names the GLOBAL
* catalog, and UniVerse packages are cataloged LOCAL -- per account, which is
* also what makes each program typeable as a verb.  Asking for "*MVPKG.MAPFIELD"
* therefore fails with "is not in the CATALOG space" even though the program is
* cataloged and callable; the bare name resolves through this account's VOC.
   DEFFUN HTTPGET(A) CALLING "MVPKG.HTTPGET"
   DEFFUN JSONDECODE(A, B) CALLING "MVPKG.JSONDECODE"
   DEFFUN MAPFIELD(A, B, C, D, E) CALLING "MVPKG.MAPFIELD"
   S = @SENTENCE
$ENDIF
   A1 = FIELD(S, " ", 3)
   CALL MVPKG.REG(REG)
   SPEC = ""
   SPEC<-1> = MAPFIELD("name", 1, "", "TEXT", "packages")
   SPEC<-1> = MAPFIELD("version", 2, "", "TEXT", "packages")
   SPEC<-1> = MAPFIELD("description", 3, "", "TEXT", "packages")
   BODY = HTTPGET(REG : "/search?q=" : A1)
   IF BODY = "" THEN PRINT "no packages match " : '"' : A1 : '"' ; RETURN
   R = JSONDECODE(BODY, SPEC)
   N = DCOUNT(R<1>, @VM)
   IF N = 0 OR R<1> = "" THEN PRINT "no packages match " : '"' : A1 : '"' ; RETURN
   FOR I = 1 TO N
$IFDEF MVX
      PRINT R<1,I> "L#16" : R<2,I> "L#10" : R<3,I>
$ELSE
      PRINT FMT(R<1,I>, "16L") : FMT(R<2,I>, "10L") : R<3,I>
$ENDIF
   NEXT I
   RETURN