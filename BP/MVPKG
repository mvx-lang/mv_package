*
* A Composer/npm for MultiValue: it talks to a registry over HTTP, resolves a
* package, downloads its release tar archive and installs it into an account.
* The client only ever downloads and unpacks the archive whole — it never
* inspects, compiles, or otherwise depends on its contents.  A release may be
* binary-only (pre-built CATALOG executables + LIB libraries with no BP source
* at all), and installs exactly the same way as one that ships source.
* Portable BASIC: the only non-MV operations (untar, mkdir) go through
* MVPKGOS, so the same source runs on any MV system with an MVPKGOS.
*
* Commands (case-insensitive — MV devs work with Caps Lock on):
*   MVPKG install <name> [<dest>]  download the release tar, install into <dest>
*                                  (<dest> defaults to a directory named <name>)
*   MVPKG rebuild                  rebuild the host's shared native library
*                                  from every installed contribution (UniData)
*   MVPKG info <name>              show a package's registry metadata
*   MVPKG search <term>            list packages whose name/description matches
*   MVPKG setup <url>              set (and persist) the registry base URL
*   MVPKG config                   show the current registry URL
*
* The registry URL is taken from $MVPKG_REGISTRY, then a persisted config
* record, then the built-in default.
   S = SENTENCE()
   CMD = OCONV(FIELD(S, " ", 2), "MCL")
   A1 = FIELD(S, " ", 3)
   A2 = FIELD(S, " ", 4)

   DEFURL = "https://mv-package.heydon.io"
   CONF = ENV("MVXACCOUNT")
   IF CONF = "" THEN CONF = "."
   CONF = CONF : "/mvpkg.conf"

   GOSUB GETREG
   BEGIN CASE
      CASE CMD = "install" ; GOSUB INSTALL
      CASE CMD = "rebuild" ; GOSUB REBUILD
      CASE CMD = "info"    ; GOSUB INFO
      CASE CMD = "search"  ; GOSUB SEARCH
      CASE CMD = "setup"   ; GOSUB SETUP
      CASE CMD = "config"  ; PRINT "registry: ":REG
      CASE 1               ; GOSUB USAGE
   END CASE
   STOP

* --- resolve the registry base URL -------------------------------------
GETREG:
   REG = ENV("MVPKG_REGISTRY")
   IF REG = "" THEN
      REG = OSREAD(CONF)
      IF STATUS() # 0 THEN REG = ""
      REG = TRIM(REG, CHAR(10), "T")
   END
   IF REG = "" THEN REG = DEFURL
   RETURN

* --- MVPKG setup <url> -------------------------------------------------
SETUP:
   IF A1 = "" THEN
      PRINT "usage: MVPKG setup <registry-url>"
      RETURN
   END
   X = OSWRITE(A1, CONF)
   IF X THEN
      PRINT "cannot write config ":CONF
   END ELSE
      PRINT "registry set to ":A1
   END
   RETURN

* --- this client's platform as a registry query string ----------------
* PLATQ = "?system=<sys>&arch=<arch>" so the registry serves the matching
* prebuilt binary artifact; "" if the platform can't be determined (the
* registry then serves the portable source tar).  Resolved once, via the
* MVPKGOS seam, and cached.
GETPLAT:
   IF PLATSET THEN RETURN
   PLATSET = 1
   PLATQ = ""
   CALL MVPKGOS("PLATFORM", "", "", PLAT)
   IF PLAT # "" AND INDEX(PLAT, ":", 1) THEN
      PSYS = FIELD(PLAT, ":", 1)
      PARCH = FIELD(PLAT, ":", 2)
      PEND = FIELD(PLAT, ":", 3)
      IF PSYS # "" AND PARCH # "" THEN
         PLATQ = "?system=" : PSYS : "&arch=" : PARCH
         IF PEND # "" THEN PLATQ := "&endian=" : PEND
      END
   END
   RETURN

* --- fetch + decode package FM's metadata into META -------------------
* META<1>=name <2>=version <3>=tarball <4>=description <5>=deps (space-sep);
* "" on miss.
FETCHMETA:
   SPEC = ""
   SPEC<-1> = MAPFIELD("name", 1)
   SPEC<-1> = MAPFIELD("version", 2)
   SPEC<-1> = MAPFIELD("tarball", 3)
   SPEC<-1> = MAPFIELD("description", 4)
   SPEC<-1> = MAPFIELD("dependencies", 5)
   GOSUB GETPLAT
   BODY = HTTPGET(REG : "/package/" : FM : PLATQ)
   IF BODY = "" THEN
      META = ""
   END ELSE
      META = JSONDECODE(BODY, SPEC)
   END
   RETURN

* --- MVPKG info <name> -------------------------------------------------
INFO:
   IF A1 = "" THEN PRINT "usage: MVPKG info <name>" ; RETURN
   FM = A1 ; GOSUB FETCHMETA
   IF META = "" THEN
      PRINT A1:": not found in registry ":REG
      RETURN
   END
   PRINT "name:         ":META<1>
   PRINT "version:      ":META<2>
   PRINT "description:  ":META<4>
   PRINT "dependencies: ":META<5>
   PRINT "tarball:     ":REG:META<3>
   RETURN

* --- MVPKG search <term> ----------------------------------------------
SEARCH:
   SPEC = ""
   SPEC<-1> = MAPFIELD("name", 1, "", "TEXT", "packages")
   SPEC<-1> = MAPFIELD("version", 2, "", "TEXT", "packages")
   SPEC<-1> = MAPFIELD("description", 3, "", "TEXT", "packages")
   BODY = HTTPGET(REG : "/search?q=" : A1)
   IF BODY = "" THEN
      PRINT "no packages match """:A1:""""
      RETURN
   END
   R = JSONDECODE(BODY, SPEC)
   N = DCOUNT(R<1>, @VM)
   IF N = 0 OR R<1> = "" THEN
      PRINT "no packages match """:A1:""""
      RETURN
   END
   FOR I = 1 TO N
      PRINT R<1,I> "L#16" : R<2,I> "L#10" : R<3,I>
   NEXT I
   RETURN

* --- MVPKG install <name> [<dest>] ------------------------------------
* Install a package and everything it depends on, dependencies first.  A
* package declares its dependencies in the registry metadata (space-
* separated names); installed names are recorded in mvpkg.installed in the
* account so a dependency already present is not reinstalled.
INSTALL:
   IF A1 = "" THEN GOSUB USAGE ; RETURN
   MFILE = ENV("MVXACCOUNT")
   IF MFILE = "" THEN MFILE = "."
   MFILE = MFILE : "/mvpkg.installed"
   MTEXT = OSREAD(MFILE)
   IF STATUS() # 0 THEN MTEXT = ""
   INSTALLED = ""
   FOR I = 1 TO DCOUNT(MTEXT, CHAR(10))
      LN = TRIM(FIELD(MTEXT, CHAR(10), I))
      IF LN # "" THEN INSTALLED<-1> = LN
   NEXT I

   * ---- phase 1: transitive closure; DEPSOF<i> parallels NEED<i> -------
   NEED = A1
   DEPSOF = ""
   K = 1
   LOOP WHILE K <= DCOUNT(NEED, @AM) DO
      FM = NEED<K> ; GOSUB FETCHMETA
      IF META = "" THEN PRINT NEED<K>:": not found in registry ":REG ; RETURN
      DEPSOF<K> = META<5>
      FOR J = 1 TO DCOUNT(META<5>, " ")
         D = FIELD(META<5>, " ", J)
         IF D # "" THEN
            SEEN = 0
            FOR X = 1 TO DCOUNT(NEED, @AM)
               IF NEED<X> = D THEN SEEN = 1
            NEXT X
            IF SEEN = 0 THEN NEED<-1> = D
         END
      NEXT J
      K = K + 1
   REPEAT

   * ---- phase 2: install deps-first (topological) ---------------------
   NP = DCOUNT(NEED, @AM)
   DONE = 0
   LOOP UNTIL DONE DO
      PROGRESS = 0 ; PENDING = 0
      FOR I = 1 TO NP
         P = NEED<I>
         DONEP = 0
         FOR X = 1 TO DCOUNT(INSTALLED, @AM)
            IF INSTALLED<X> = P THEN DONEP = 1
         NEXT X
         IF DONEP = 0 THEN
            PENDING = PENDING + 1
            READY = 1
            FOR J = 1 TO DCOUNT(DEPSOF<I>, " ")
               D = FIELD(DEPSOF<I>, " ", J)
               IF D # "" THEN
                  HAVE = 0
                  FOR X = 1 TO DCOUNT(INSTALLED, @AM)
                     IF INSTALLED<X> = D THEN HAVE = 1
                  NEXT X
                  IF HAVE = 0 THEN READY = 0
               END
            NEXT J
            IF READY THEN
               IF P = A1 AND A2 # "" THEN THISDEST = A2 ELSE THISDEST = P
               FM = P ; GOSUB FETCHMETA ; GOSUB DOINSTALL
               INSTALLED<-1> = P
               PROGRESS = 1
            END
         END
      NEXT I
      IF PENDING = 0 THEN DONE = 1
      IF PROGRESS = 0 AND PENDING > 0 THEN
         PRINT "mvpkg: cannot resolve dependencies (cycle or missing)"
         DONE = 1
      END
   REPEAT

   MTEXT = ""
   FOR I = 1 TO DCOUNT(INSTALLED, @AM)
      MTEXT = MTEXT : INSTALLED<I> : CHAR(10)
   NEXT I
   X = OSWRITE(MTEXT, MFILE)
   RETURN

* --- install one package: FM = name, THISDEST = dest, META fetched ----
DOINSTALL:
   DEST = THISDEST
   TMP = "/tmp/mvpkg_" : CHANGE(FM, "/", "_") : ".tar.gz"
   PRINT "fetching ":META<1>:" ":META<2>:" ..."
   ST = HTTPGETFILE(REG : META<3>, TMP)
   IF ST < 200 OR ST >= 300 THEN
      PRINT "download failed (status ":ST:")"
      RETURN
   END
   CALL MVPKGOS("UNTAR", TMP, DEST, ERR)
   IF ERR # "" THEN PRINT ERR ; RETURN
   X = OSDELETE(TMP)
   PRINT "installed ":META<1>:" ":META<2>:" into ":DEST
   * A package that reaches into the host through native CallC ships a
   * udt-callc/ contribution; integrate it (on UniData this rebuilds the
   * shared library from every native package installed).  A no-op for a
   * package or platform without one.
   CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
   IF ERR # "" THEN PRINT ERR
   RETURN

* --- MVPKG rebuild -----------------------------------------------------
* Rebuild the host's shared native (CallC) library from every installed
* contribution — recovery, or after a manual add/remove.  No-op where the
* platform has no such library (e.g. MVX).
REBUILD:
   CALL MVPKGOS("REBUILD", "", "", ERR)
   IF ERR # "" THEN PRINT ERR ; RETURN
   PRINT "rebuilt the native library from installed contributions"
   RETURN

USAGE:
   PRINT "usage:"
   PRINT "  MVPKG install <name> [<dest>]"
   PRINT "  MVPKG rebuild"
   PRINT "  MVPKG info <name>"
   PRINT "  MVPKG search <term>"
   PRINT "  MVPKG setup <registry-url>"
   PRINT "  MVPKG config"
   RETURN