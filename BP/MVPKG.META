* mv_package — MVPKG helper: fetch and decode a package's metadata.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG.META(NAME, VER, REG, META) — fetch package NAME's metadata from registry
* REG over HTTP and decode it.  VER="" resolves the latest; an exact version
* (to satisfy a dependency constraint) asks for that one (?version=).
* META<1>=name <2>=version <3>=tarball <4>=description <5>=dependencies
* <6>=versions (space-separated, newest-first) <7>=provides (virtual names this
* package satisfies, space-separated) <8>=source (repo URL, for --source clones)
* <9>=clibs (OS C libraries the package's CallC needs, space-separated sonames);
* META = "" on a miss.  (Client code uses META<20> for a --source working-copy
* path override — a high slot the registry never fills.)
*
* The request carries this client's platform as a query string
* (?system=&arch=&os=&endian=), resolved through the MVPKGOS seam, so the
* registry can serve the matching prebuilt binary artifact — else source.
* HTTP/JSON/MAPFIELD are MVX intrinsics; UniData reaches them as the cataloged
* seam functions, so declare those only off MVX.
   SUBROUTINE MVPKG.META(NAME, VER, REG, META)
$IFNDEF MVX
   DEFFUN HTTPGET(A) CALLING "*MVPKG.HTTPGET"
   DEFFUN JSONDECODE(A, B) CALLING "*MVPKG.JSONDECODE"
   DEFFUN MAPFIELD(A, B, C, D, E) CALLING "*MVPKG.MAPFIELD"
$ENDIF
   SPEC = ""
   SPEC<-1> = MAPFIELD("name", 1, "", "", "")
   SPEC<-1> = MAPFIELD("version", 2, "", "", "")
   SPEC<-1> = MAPFIELD("tarball", 3, "", "", "")
   SPEC<-1> = MAPFIELD("description", 4, "", "", "")
   SPEC<-1> = MAPFIELD("dependencies", 5, "", "", "")
   SPEC<-1> = MAPFIELD("versions", 6, "", "", "")
   SPEC<-1> = MAPFIELD("provides", 7, "", "", "")
   SPEC<-1> = MAPFIELD("srcrepo", 8, "", "", "")
   SPEC<-1> = MAPFIELD("clibs", 9, "", "", "")
   SPEC<-1> = MAPFIELD("selected", 10, "", "", "")
   PLATQ = ""
   CALL MVPKGOS("PLATFORM", "", "", PLAT)
   IF PLAT # "" AND INDEX(PLAT, ":", 1) THEN
      PSYS = FIELD(PLAT, ":", 1)
      POS = FIELD(PLAT, ":", 2)
      PARCH = FIELD(PLAT, ":", 3)
      PEND = FIELD(PLAT, ":", 4)
      IF PSYS # "" AND PARCH # "" THEN
         PLATQ = "?system=" : PSYS : "&arch=" : PARCH
         IF POS # "" THEN PLATQ := "&os=" : POS
         IF PEND # "" THEN PLATQ := "&endian=" : PEND
      END
   END
   Q = PLATQ
   IF VER # "" THEN
      IF Q = "" THEN
         Q = "?version=" : VER
      END ELSE
         Q = "?version=" : VER : "&" : Q[2, LEN(Q)]
      END
   END
   BODY = HTTPGET(REG : "/package/" : NAME : Q)
   IF BODY = "" THEN
      META = ""
   END ELSE
      META = JSONDECODE(BODY, SPEC)
      * A miss returns a JSON error object ({"error":"not found"}) with no
      * "name" — treat any response without a resolved name as a miss (META="").
      * Otherwise the caller "installs" an empty package: blank name -> blank
      * store dir -> it rm's/untars the whole store root and catalogs nothing.
      IF META<1> = "" THEN META = ""
   END
   RETURN