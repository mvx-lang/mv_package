* MVPKG.ENV - read one environment variable.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
*   ENAME  in   the variable's name
*   EVAL   out  its value, "" when unset
*
* MVX spells this ENV(); UniData and jBASE spell it GETENV() (PLATFORM.H maps
* the one to the other on MVX).  UNIVERSE HAS NEITHER, and does not fail
* helpfully: it parses GETENV("HOME") as a subscripted array and reports
*
*     Array 'GETENV' never dimensioned.
*
* so the error names neither the function nor the environment.  Its only route
* to the environment is to ask a shell, which is why this seam exists at all --
* one place to be slow and strange, instead of twenty.
   SUBROUTINE MVPKG.ENV(ENAME, EVAL)
$INCLUDE MVPKG.INC PLATFORM.H
   EVAL = ""
   IF TRIM(ENAME) = "" THEN RETURN
$IFDEF UV
   CALL MVPKG.SH("printenv " : TRIM(ENAME), EOUT, ESTAT)
* CAPTURING yields @AM-separated lines, so take the first line as a FIELD on
* @AM -- splitting on CHAR(10) leaves the mark attached to the value.
   EVAL = TRIM(FIELD(EOUT, @AM, 1))
   EVAL = TRIM(FIELD(EVAL, CHAR(10), 1))
* printenv exits non-zero for a variable that is not set; anything it printed in
* that case is not a value.
   IF ESTAT # 0 THEN EVAL = ""
$ENDIF
$IFDEF JBASE
   EVAL = GETENV(ENAME)
$ENDIF
$IFDEF UDT
   EVAL = GETENV(ENAME)
$ENDIF
$IFDEF MVX
   EVAL = GETENV(ENAME)
$ENDIF
   RETURN

