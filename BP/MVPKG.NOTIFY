* mv_package — MVPKG subcommand: notify (UniData port).
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG notify — meant for an account's LOGIN paragraph.  If any package
* DEPLOYED in this account is behind the SYSTEM store (it was upgraded in
* another account, so MVPKG.STORE's version is newer than this account's
* MVPKG.LOCK version), pop up a modal listing them; the user presses OK to
* acknowledge and login continues.
*
* TWO questions have to be asked, and neither answers the other:
*
*   IS THERE A TERMINAL?  @USER.TYPE, where it can be asked.
*   IS A PROGRAM ABOVE US?  @LEVEL, everywhere.
*
* The second is not optional.  An account's LOGIN runs on every LOGTO,
* including one from inside a RUNNING PROGRAM -- a session that is genuinely
* interactive, so @USER.TYPE passes it -- and drawing a modal there covers
* that program's screen and eats the keystroke it was waiting for.
   SUBROUTINE MVPKG.NOTIFY
$INCLUDE MVPKG.INC PLATFORM.H
* @USER.TYPE is UniData's session-type test, so the check is guarded rather
* than the whole program.  Where it cannot be asked, assume interactive -- the
* notify is advisory, and staying silent in a real terminal is a worse failure
* than printing in a phantom.
*
* WHERE IT CANNOT BE ASKED IS TWO PLATFORMS, NOT ONE.  UniVerse has no such
* variable and says so at compile time.  jBASE COMPILES IT AND RETURNS AN
* EMPTY STRING -- and "" # 0 is TRUE there (measured on 6.2.1.1, and on
* UniData and mvx alike), so `IF @USER.TYPE # 0' fired ALWAYS and notify
* silently never ran on jBASE, on any terminal.  It must assume interactive
* for the same reason UniVerse does.
$IFDEF UV
   MVNOTIFYOK = 1
$ENDIF
$IFDEF JBASE
   MVNOTIFYOK = 1
$ENDIF
$IFDEF UDT
   MVNOTIFYOK = 1 ; IF @USER.TYPE # 0 THEN MVNOTIFYOK = 0
$ENDIF
$IFDEF MVX
   MVNOTIFYOK = 1 ; IF @USER.TYPE # 0 THEN MVNOTIFYOK = 0
$ENDIF
   IF NOT(MVNOTIFYOK) THEN RETURN          ;* no terminal at all

* AND NOT OVER SOMEONE ELSE'S SCREEN.  @LEVEL compiles on all four -- measured
* on UniData 8.3, UniVerse 14.2.1, jBASE 6.2.1.1 and mvx -- and reads 0 at a
* fresh login, 1 when a LOGTO from a running program fired the LOGIN.
*
* It is not portable as a BOOLEAN: ScarletDME (OpenQM) counts from 1, so this
* test would be true at the top level there and disable notify the same way
* jBASE's @USER.TYPE did.  mvpkg does not target it; a port needs a captured
* base rather than a truth test.
   IF @LEVEL THEN RETURN                   ;* a program is above us

   * find packages deployed here that the system store has a newer version of
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", LREC)
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   UPG = "" ; UFROM = "" ; UTO = ""
   FOR I = 1 TO DCOUNT(LREC<2>, @VM)
      NM = TRIM(LREC<2,I>) ; LV = TRIM(LREC<3,I>)
      IF NM # "" AND LV # "" AND LV # "source" THEN
         LOCATE(NM, SREC, 2; SP) THEN
            SV = TRIM(SREC<3,SP>)
            IF SV # "" AND SV # "source" THEN
               CALL SEMVER("CMP", SV, LV, CR)
               IF CR > 0 THEN UPG<-1> = NM ; UFROM<-1> = LV ; UTO<-1> = SV
            END
         END
      END
   NEXT I
   IF DCOUNT(UPG, @AM) = 0 OR UPG<1> = "" THEN RETURN   ;* nothing behind — silent

   * the message the modal shows
   MSG = "Package updates are available in this account:"
   FOR I = 1 TO DCOUNT(UPG, @AM)
      MSG<-1> = "   " : UPG<I> : "   " : UFROM<I> : "  ->  " : UTO<I>
   NEXT I
   MSG<-1> = ""
   MSG<-1> = "Run  MVPKG update  to upgrade this account."

   * draw it: a boxed curses modal when the curses package is deployed here,
   * else a plain terminal prompt (no dependency).  MVPKG.HAS is the runtime probe.
   CALL MVPKG.HAS("mvx-lang/curses", HASCURS)
   IF HASCURS THEN GOSUB CURSMODAL ELSE GOSUB STDMODAL
   RETURN

* STDMODAL — a plain prompt that works on any terminal; OK = the RETURN key.
STDMODAL:
   PRINT
   PRINT STR("=", 64)
   FOR I = 1 TO DCOUNT(MSG, @AM)
      PRINT MSG<I>
   NEXT I
   PRINT STR("=", 64)
   PRINT "[ Press RETURN to continue ] " :
   INPUT DUMMY
   RETURN

* CURSMODAL — a boxed modal via the curses package (an OK button read with its
* named KEYIN).  TODO: draw with the curses primitives; for now it falls back to
* the standard prompt so notify is fully functional without curses drawing yet.
CURSMODAL:
   GOSUB STDMODAL
   RETURN
