* mv_package — MVPKG subcommand: update.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG update [<name>] — upgrade an installed package (or, with no name,
* every installed package) to the newest version this account's stability
* policy admits.  For each: resolve a target from the registry's published
* versions under the account's minimum-stability, and if it is NEWER than what
* is installed, run the normal global install (MVPKG.ONE) for it (download +
* build/catalog + deploy).  A --source working copy fast-forwards with git pull
* and rebuilds in place instead.
*
* IT USED TO TAKE THE REGISTRY'S CURRENT VERSION AND MOVE TO IT, in whichever
* direction that was.  The current version is the promoted STABLE one, so an
* account that had deliberately installed a release candidate was told
*
*     updating mvx-lang/git 2.1.0-rc1 -> 2.0.3
*
* and rolled backwards -- with "updating" printed on the line that did it, and
* no way to tell from the output that anything was wrong.  Two faults: it
* ignored minimum-stability (mv_package#30), and it never asked whether the
* version it had chosen was newer than the one already there (mv_package#113).
   SUBROUTINE MVPKG.UPDATE
$IFDEF MVX
   S = SENTENCE()
$ELSE
   S = @SENTENCE
$ENDIF
   A1 = FIELD(S, " ", 3)
   CALL MVPKG.REG(REG)
   * THE SAME POLICY `install` RESOLVES UNDER.  An account that accepts release
   * candidates must not be updated back onto the stable line behind its back.
   CALL MVPKGOS("MDREAD", "MVPKG.MANIFEST", "", UFR)
   UFLOOR = OCONV(TRIM(UFR<3>), "MCL")
   IF UFLOOR = "" THEN UFLOOR = "stable"
   CALL SEMVER("RANK", UFLOOR, "", UFRANK)
   IF UFRANK = 0 THEN UFLOOR = "stable"
   UPREFST = 0
   IF TRIM(UFR<4>) = "1" THEN UPREFST = 1
   CALL MVPKGOS("STORE", "", "", STORE)
   * SYSTEM inventory — MVPKG.STORE "installed" (<2> names / <3> versions)
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   NAMES = ""
   IF A1 # "" THEN
      NAMES = A1
   END ELSE
      FOR GI = 1 TO DCOUNT(SREC<2>, @VM)
         IF TRIM(SREC<2,GI>) # "" THEN NAMES<-1> = TRIM(SREC<2,GI>)
      NEXT GI
   END
   NN = DCOUNT(NAMES, @AM)
   IF NN = 0 OR NAMES<1> = "" THEN PRINT "no packages installed" ; RETURN
   FOR NI = 1 TO NN
      NM = NAMES<NI>
      CALL MVPKGOS("STOREREAD", "installed", "", SREC)
      INSTVER = ""
      LOCATE(NM, SREC, 2; SPOS) THEN INSTVER = TRIM(SREC<3,SPOS>)
      BEGIN CASE
         CASE INSTVER = ""
            PRINT NM : ": not installed (use MVPKG install)"
         CASE INSTVER = "source"
            GOSUB SRCUPDATE           ;* a --source working copy: git pull in place
         CASE 1
            CALL MVPKG.META(NM, "", REG, META)
            * The package's own stability flag, if the manifest declares one
            * ("mvx-lang/git@rc"): a floor raised for this package alone has to
            * survive an update, or the next one undoes the decision.
            GOSUB PKGFLOOR
            UTGT = ""
            IF META # "" THEN CALL MVPKG.PICK(META<6>, "", UEFF, UPREFST, UTGT)
            IF UTGT = "" THEN UTGT = META<2>
            UCMP = 0
            IF UTGT # "" AND INSTVER # "" THEN CALL SEMVER("CMP", UTGT, INSTVER, UCMP)
            BEGIN CASE
               CASE META = ""
                  PRINT NM : ": not found in registry " : REG
               CASE UTGT = INSTVER
                  PRINT NM : " " : INSTVER : " is up to date"
               CASE UCMP < 0
                  * NEWER THAN THE REGISTRY OFFERS IS NOT AN UPDATE.  Say so
                  * rather than moving backwards: at a stable floor this is what
                  * an installed pre-release looks like, and it is deliberate.
                  PRINT NM : " " : INSTVER : " is newer than " : UTGT : ", the newest " : UEFF : " release — leaving it"
               CASE 1
                  PRINT "updating " : NM : " " : INSTVER : " -> " : UTGT
                  * THE REFETCH IS CONDITIONAL; THE INSTALL IS NOT.  META
                  * already describes the registry's current version, so it is
                  * re-read only when the target is some OTHER version -- but
                  * wrapping the install in that same test skipped it entirely
                  * in the ordinary case, and `update` then announced a move it
                  * did not make: "updating cmd 1.3.0 -> 1.4.1", and 1.3.0 still
                  * installed afterwards.
                  UMOK = 1
                  IF UTGT # META<2> THEN
                     CALL MVPKG.META(NM, UTGT, REG, META)
                     IF META = "" THEN
                        PRINT NM : " " : UTGT : ": not found in registry " : REG
                        UMOK = 0
                     END
                  END
                  IF UMOK THEN
                  * MVPKG.ONE re-fetches the new version and updates the store
                  * inventory's version in place (LOCATE on <2>).
$IFNDEF MVX
                  * #33: capture the OLD account footprint before redeploying, so
                  * the diff below can reverse any verb the new version drops.
                  GOSUB OLDFEET
$ENDIF
                  CALL MVPKG.ONE(META, REG, OERR)
                  IF OERR # "" THEN
                     PRINT NM : ": update failed — " : OERR
                  END ELSE
$IFNDEF MVX
                     GOSUB NEWFEET   ;* UNVERB (old - new), refresh the account lock
$ENDIF
                  END
                  END
            END CASE
      END CASE
UNEXT:
   NEXT NI
   RETURN

* PKGFLOOR — UEFF: the floor to resolve THIS package under.  The project's,
* unless its own manifest spec raises it ("mvx-lang/git@rc").  Matched on the
* bare name, the way MANIFESTADD stores it.
PKGFLOOR:
   UEFF = UFLOOR
   FOR UMI = 1 TO DCOUNT(UFR<2>, @VM)
      USP = TRIM(UFR<2,UMI>)
      IF USP # "" THEN
         UAT = INDEX(USP, "@", 1)
         IF UAT > 0 THEN
            UWORD = USP[UAT + 1, LEN(USP)]
            UBASE = USP[1, UAT - 1]
            IF UBASE[1, 1] = "?" THEN UBASE = UBASE[2, LEN(UBASE)]
            IF UBASE = NM THEN
               CALL SEMVER("RANK", UWORD, "", UWR)
               IF UWR > 0 THEN UEFF = OCONV(UWORD, "MCL")
            END
         END
      END
   NEXT UMI
   RETURN

$IFNDEF MVX
* #33 upgrade footprint (UniData).  An upgrade redeploys the new version's verbs
* over the old, but a verb the new version DROPPED would be left orphaned.  So we
* record the old footprint (OLDFEET) before MVPKG.ONE, compute the new one from the
* upgraded store manifest, UNVERB the difference, and refresh the account lock's
* version + footprint (NEWFEET) — the lock now tracks what is actually deployed.
* (MVX links/unlinks the whole package as a unit, so it needs none of this.)
OLDFEET:
   OLDV = ""
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", ULREC)
   LOCATE(NM, ULREC, 2; ULPOS) THEN
      OFP = ULREC<7,ULPOS>
      FOR UI = 1 TO DCOUNT(OFP, @SM)
         ART = OFP<1,1,UI>
         IF ART[1,1] = "V" THEN
            VN = TRIM(ART[3, LEN(ART)])
            IF VN # "" THEN OLDV<-1> = VN
         END
      NEXT UI
   END
   RETURN

NEWFEET:
   CALL MVPKGOS("STORE", "", "", USTORE)
   UKEY = CHANGE(NM, "/", "_")
   CALL MVPKG.FILE("READ", USTORE : "/" : UKEY : "/mvpkg.json", UMJ, MVFOK)
   NEWV = "" ; NFP = ""
   IF UMJ # "" THEN
      CALL MVPKGDEP(UMJ, UVERBS, UFILES, UFB, UINC)
      FOR UI = 1 TO DCOUNT(UVERBS, " ")
         VV = FIELD(UVERBS, " ", UI)
         IF VV # "" THEN NEWV<-1> = VV ; NFP<1,1,-1> = "V " : VV
      NEXT UI
      FOR UI = 1 TO DCOUNT(UFILES, " ")
         FF = FIELD(UFILES, " ", UI)
         IF FF # "" THEN NFP<1,1,-1> = "F " : FF
      NEXT UI
   END
   * reverse verbs present in the OLD footprint but not the NEW (the upgrade
   * dropped them) — files are left alone, they hold account data.
   FOR UI = 1 TO DCOUNT(OLDV, @AM)
      OV = OLDV<UI>
      KEEP = 0
      FOR UJ = 1 TO DCOUNT(NEWV, @AM)
         IF NEWV<UJ> = OV THEN KEEP = 1
      NEXT UJ
      IF KEEP = 0 AND OV # "" THEN
         CALL MVPKGOS("UNVERB", OV, "", UVERR)
         PRINT "  dropped verb " : OV : " (gone in " : META<2> : ")"
      END
   NEXT UI
   * refresh the account lock in place: new version + new footprint
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", ULREC)
   LOCATE(NM, ULREC, 2; ULPOS) THEN
      ULREC<3,ULPOS> = META<2>
      ULREC<7,ULPOS> = NFP
      CALL MVPKGOS("MDWRITE", "MVPKG.LOCK", ULREC, UERR)
      IF UERR # "" THEN PRINT "mvpkg: " : UERR
   END
   RETURN
$ENDIF

* SRCUPDATE — a package installed with --source is a plain git working copy, so
* "update" is a fast-forward `git pull` in that directory (the path was recorded
* under the store's src/ marker at install).  --ff-only so local commits/edits
* are never clobbered — resolve those by hand.
SRCUPDATE:
   PKGKEY = CHANGE(NM, "/", "_")
   CALL MVPKGOS("STOREREAD", "SRC." : PKGKEY, "", WCDIR)
   WCDIR = TRIM(WCDIR)
   IF WCDIR = "" THEN PRINT NM : ": source working-copy path not recorded" ; RETURN
   PRINT "updating " : NM : " (git pull in " : WCDIR : ") ..."
   TMPF = "/tmp/mvpkg_pull_" : @USERNO
   CALL MVPKG.SH('cd "' : WCDIR : '" && git pull --ff-only; echo $? > "' : TMPF : '"', MVSHOUT, MVSHST)
   CALL MVPKG.FILE("READ", TMPF, RC, MVFOK)
   IF NOT(MVFOK) THEN RC = "1"
   CALL MVPKG.SH('rm -f "' : TMPF : '"', MVSHOUT, MVSHST)
   * CONVERT() argument order differs on jBASE; FIELD says it portably
   * (mv_package#54).
   RC = TRIM(FIELD(FIELD(FIELD(RC, @AM, 1), CHAR(10), 1), CHAR(13), 1))
   IF RC # "0" THEN
      PRINT NM : ": git pull failed (exit " : RC : ") — resolve local changes in " : WCDIR
      RETURN
   END
   * rebuild + redeploy the working copy through the standard declarative path,
   * so the pulled (or locally edited) source goes live.
   PRINT NM : ": pulled — rebuilding ..."
   CALL MVPKG.META(NM, "", REG, MB)
   IF MB # "" THEN
      MB<20> = WCDIR
      CALL MVPKG.ONE(MB, REG, OERR)
      IF OERR # "" THEN PRINT NM : ": rebuild failed — " : OERR
   END
   RETURN
