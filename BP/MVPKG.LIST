* mv_package — MVPKG subcommand: list.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG list [--long] [--all] — show packages as a table:
*   PACKAGE  VERSION  STATUS  DESCRIPTION.
* By default only packages DEPLOYED in the current account are listed; --all/-a
* lists every package installed on the SYSTEM (the MVPKG.STORE inventory).
*   name + version : the MVPKG.STORE "installed" record (the system inventory).
*   description    : read from each package's stored mvpkg.json (local; blank
*                    for a package adopted via `register`, which has no store copy).
*                    Truncated to one line unless --long, which wraps the full
*                    text over multiple lines, aligned under the DESCRIPTION column.
*   status         : per the CURRENT account — "deployed" when this account's
*                    MVPKG.LOCK record lists it, else "system" (in the shared store
*                    but not deployed into this account; shown only with --all).
* JSON/MAPFIELD are MVX intrinsics (declared as the cataloged seam off MVX); the
* @SENTENCE token, the FMT justify masks, and the OSREAD form are the other diffs.
   SUBROUTINE MVPKG.LIST
   $INCLUDE MVPKG.INC PLATFORM.H
* COLUMNS ARE PADDED BY HAND, NOT BY FMT.  FMT does not clip a value wider than
* its mask, it WRAPS -- and differently per platform, so the same row broke three
* ways.  FMT("1.18.1-test", "9L") is 19 characters on UniData and jBASE (the
* first nine, a text mark, then the rest padded to nine) and 9 on UniVerse, which
* truncates with no gap before the next column (#89).  PADCOL below gives exactly
* the width asked for, everywhere, and the per-platform justify masks that used
* to live here are gone with it.
* jBASE HAS NO `DEFFUN ... CALLING`.  That clause is how U2 points a local name
* at a cataloged one; jBASE resolves a DEFFUN by NAME against the catalog, and
* the names are already there because mvpkg's dependencies catalog them.
*
* FLAT GUARDS, one per platform: an $IFDEF nested inside an $ELSE compiles on
* UniData and FAILS on UniVerse, which is what this block used to be.
$IFDEF JBASE
   DEFFUN JSONDECODE(A, B)
   DEFFUN MAPFIELD(A, B, C, D, E)
$ENDIF
$IFDEF UDT
   DEFFUN JSONDECODE(A, B) CALLING "*MVPKG.JSONDECODE"
   DEFFUN MAPFIELD(A, B, C, D, E) CALLING "*MVPKG.MAPFIELD"
$ENDIF
$IFDEF UV
* NO "*" HERE, unlike the UniData arm above.  A leading star names the GLOBAL
* catalog, and UniVerse packages are cataloged LOCAL -- per account, which is
* also what makes each program typeable as a verb.  Asking for "*MVPKG.MAPFIELD"
* therefore fails with "is not in the CATALOG space" even though the program is
* cataloged and callable; the bare name resolves through this account's VOC.
   DEFFUN JSONDECODE(A, B) CALLING "MVPKG.JSONDECODE"
   DEFFUN MAPFIELD(A, B, C, D, E) CALLING "MVPKG.MAPFIELD"
$ENDIF
   * flags: --long/-l wraps the full description; --all/-a lists every package on
   * the SYSTEM (the store), not just the ones deployed in THIS account.
   LONG = 0 ; ALLP = 0
$IFDEF MVX
   SENT = SENTENCE()
$ELSE
   SENT = @SENTENCE
$ENDIF
   FOR FI = 1 TO DCOUNT(SENT, " ")
      W = FIELD(SENT, " ", FI)
      IF W = "--long" OR W = "-l" THEN LONG = 1
      IF W = "--all" OR W = "-a" THEN ALLP = 1
   NEXT FI
   CALL MVPKGOS("STORE", "", "", STORE)
   * the SYSTEM inventory — the MVPKG.STORE "installed" record (<2> names,
   * <3> versions): everything downloaded + globally cataloged on this system
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   * this account's deployed set — the native MVPKG.LOCK record (names in <2>)
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", IREC)
   NL = DCOUNT(SREC<2>, @VM)
   NG = 0
   FOR GI = 1 TO NL
      IF TRIM(SREC<2,GI>) # "" THEN NG = NG + 1
   NEXT GI
   IF NG = 0 THEN
      * EMPTY OR UNREACHABLE?  STOREREAD answers "" to both, and saying "no
      * packages installed" when the store could not be opened is a statement
      * of fact about a question that was never asked -- it was printed right
      * after five successful installs (#67).  Ask before concluding.
      CALL MVPKGOS("STOREOK", "", "", SOERR)
      IF SOERR # "" THEN
         PRINT "mvpkg: " : SOERR
      END ELSE
         PRINT "no packages installed"
      END
      RETURN
   END
   SPEC = MAPFIELD("description", 1, "", "", "")
   * a self-registered package (mvpkg) has no store copy — its manifest is this
   * account's own mvpkg.json; read it once to fill that one row's description.
   SELFSPEC = MAPFIELD("name", 1, "", "", "")
   SELFSPEC<-1> = MAPFIELD("description", 2, "", "", "")
   CALL MVPKG.FILE("READ", "mvpkg.json", SELFJ, MVFOK)
   SELFNAME = "" ; SELFDESC = ""
   IF SELFJ # "" THEN SM = JSONDECODE(SELFJ, SELFSPEC) ; SELFNAME = TRIM(SM<1>) ; SELFDESC = TRIM(SM<2>)
   * VERSION IS 14 WIDE, NOT 9.  A pre-release carries its tag ("1.4.0-beta2" is
   * 11) and PADCOL truncates to CW-1, so the nine-wide column turned every
   * pre-release into "1.4.0-be>" — the one part of the string that says WHAT
   * KIND of build this is was the part that got cut (mv_package#30).
   INDENT = SPACE(46)          ;* 22 + 14 + 10 — aligns wrapped lines under DESCRIPTION
   * DESCRIPTION fills the rest of the terminal instead of a fixed column, so the
   * table uses the real window width (SYSTEM(2) = page width; fall back to 80).
   WID = SYSTEM(2) ; IF WID < 66 THEN WID = 80
   WRAPW = WID - 46            ;* description column = window width minus the 3 fixed cols
   CV = "PACKAGE" ; CW = 22 ; GOSUB PADCOL ; HDR = CV
   CV = "VERSION" ; CW = 14 ; GOSUB PADCOL ; HDR := CV
   CV = "STATUS"  ; CW = 10 ; GOSUB PADCOL ; HDR := CV
   PRINT HDR : "DESCRIPTION"
   SHOWN = 0
   FOR GI = 1 TO NL
      NM = TRIM(SREC<2,GI>)
      IF NM # "" THEN
         VER = TRIM(SREC<3,GI>)
         * deployed status for the current account.  The account lock may list a
         * package by its full name (a direct install) or by its short/virtual
         * name (a transitive or provides-resolved dep, e.g. "mapfield" for
         * mvx-lang/mapfield), so match either.
         STAT = "system"
         LAST = FIELD(NM, "/", DCOUNT(NM, "/"))
         LOCKVER = ""
         NM2 = DCOUNT(IREC<2>, @VM)
         FOR MI = 1 TO NM2
            AN = TRIM(IREC<2,MI>)
            IF AN # "" AND (AN = NM OR AN = LAST) THEN STAT = "deployed" ; LOCKVER = TRIM(IREC<3,MI>)
         NEXT MI
         * the system store has a NEWER version than this account deployed (it was
         * upgraded in another account) → this account needs upgrading
         IF STAT = "deployed" AND LOCKVER # "" AND VER # "" AND VER # "source" THEN
            CALL SEMVER("CMP", VER, LOCKVER, CMPR)
            IF CMPR > 0 THEN STAT = "upgrade"
         END
         * default lists only what is deployed HERE (deployed or needing upgrade);
         * --all lists the whole system, including "system" (not deployed here)
         IF ALLP OR STAT # "system" THEN
            SHOWN = SHOWN + 1
            * description from the package's stored manifest (local, no network)
            PKGKEY = CHANGE(NM, "/", "_")
            CALL MVPKG.FILE("READ", STORE : "/" : PKGKEY : "/mvpkg.json", J, MVFOK)
            DESC = ""
            IF J # "" THEN
               M = JSONDECODE(J, SPEC) ; DESC = TRIM(M<1>)
            END ELSE
               IF NM = SELFNAME THEN DESC = SELFDESC
            END
            CV = NM   ; CW = 22 ; GOSUB PADCOL ; PREFIX = CV
            CV = VER  ; CW = 14 ; GOSUB PADCOL ; PREFIX := CV
            CV = STAT ; CW = 10 ; GOSUB PADCOL ; PREFIX := CV
            IF LONG THEN
               GOSUB WRAPDESC
            END ELSE
               IF LEN(DESC) > WRAPW THEN DESC = DESC[1, WRAPW - 1] : ">"
               PRINT PREFIX : DESC
            END
         END
      END
   NEXT GI
   IF SHOWN = 0 AND ALLP = 0 THEN
      PRINT "  (nothing deployed in this account — use  MVPKG list -a  for all system packages)"
   END
   RETURN
*
* WRAPDESC — print DESC word-wrapped at WRAPW: the first line follows PREFIX (the
* name/version/status columns), each continuation line is indented so it sits
* under the DESCRIPTION column.  A word longer than WRAPW takes its own line.
WRAPDESC:
   MOUT = ""
   LINE = ""
   FOR WI = 1 TO DCOUNT(DESC, " ")
      W = FIELD(DESC, " ", WI)
      IF W # "" THEN
         IF LINE = "" THEN
            LINE = W
         END ELSE
            IF LEN(LINE) + 1 + LEN(W) <= WRAPW THEN
               LINE = LINE : " " : W
            END ELSE
               MOUT<-1> = LINE ; LINE = W
            END
         END
      END
   NEXT WI
   IF LINE # "" THEN MOUT<-1> = LINE
   NLN = DCOUNT(MOUT, @AM)
   IF NLN = 0 THEN
      PRINT PREFIX
   END ELSE
      FOR LI = 1 TO NLN
         IF LI = 1 THEN PRINT PREFIX : MOUT<LI> ELSE PRINT INDENT : MOUT<LI>
      NEXT LI
   END
   RETURN

* PADCOL — CV becomes exactly CW characters: clipped if longer, padded if
* shorter.  This is what FMT was being asked for and does not do; see the note
* at the top.  A column that has to lose characters loses them at the end, where
* the reader can see it happened, rather than gaining a text mark mid-row.
PADCOL:
* A COLUMN HAS TO KEEP ITS SEPARATOR.  Clipping to exactly CW leaves a value that
* fills the column butted against the next one -- "mvx-lang/mapfiel1.1.0" -- so
* the content gets CW-1 and the last character is always a space.  A value that
* did not fit ends in ">", the same mark the description column uses, so a
* truncated cell is visibly truncated rather than quietly wrong.
   IF LEN(CV) >= CW THEN CV = CV[1, CW - 2] : ">"
   CV = CV : SPACE(CW - LEN(CV))
   RETURN
