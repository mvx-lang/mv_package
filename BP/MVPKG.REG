* mv_package — MVPKG helper: resolve the registry base URL.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG.REG(REG) — RESULT REG is the registry base URL, taken from
* $MVPKG_REGISTRY, then the account's persisted mvpkg.conf, then the built-in
* default.  Shared by every subcommand that talks to the registry.  One source
* for both platforms: a $DEFINE prelude aliases the token diff (GETENV) and
* $IFDEF handles the structural ones (the conf location, the OSREAD form).
   SUBROUTINE MVPKG.REG(REG)
$INCLUDE MVPKG.INC PLATFORM.H
   DEFURL = "https://mv-package.heydon.io"
$IFDEF MVX
   CALL MVPKG.ENV("MVXACCOUNT", CONF)
   IF CONF = "" THEN CONF = "."
   CONF = CONF : "/mvpkg.conf"
$ELSE
   CALL MVPKG.ENV("HOME", MVENVT)
   CONF = MVENVT : "/mvpkg.conf"
$ENDIF
   CALL MVPKG.ENV("MVPKG_REGISTRY", REG)
   IF REG = "" THEN
      CALL MVPKG.FILE("READ", CONF, REG, MVFOK)
      REG = TRIM(REG, CHAR(10), "T")
   END
   IF REG = "" THEN REG = DEFURL
   * Refuse an insecure registry.  MVPKG downloads code that gets compiled,
   * cataloged and run, so plain http is a MITM code-injection vector: require
   * https.  http is allowed only for a localhost dev/test registry, or when
   * the operator opts out with MVPKG_INSECURE (a trusted private network).
   SCHEME = OCONV(FIELD(REG, ":", 1), "MCL")
   IF SCHEME # "https" THEN
      HOST = FIELD(FIELD(REG[LEN(SCHEME) + 4, LEN(REG)], "/", 1), ":", 1)
      OK = 0
      IF HOST = "localhost" OR HOST = "127.0.0.1" OR HOST = "::1" THEN OK = 1
      CALL MVPKG.ENV("MVPKG_INSECURE", MVENVT)
      IF MVENVT # "" THEN OK = 1
      IF OK = 0 THEN
         PRINT "mvpkg: refusing insecure registry (need https): " : REG
         PRINT "  fix it with:  MVPKG setup https://<host>"
         PRINT "  or set MVPKG_INSECURE=1 to allow http on a trusted network"
         STOP
      END
   END
   RETURN