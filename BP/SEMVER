* Portable semver for MVPKG dependency resolution.  GPL-2.0-only.
*   OP="CMP"  RESULT = -1/0/1  comparing VER and CONS as versions
*   OP="SAT"  RESULT = 1/0     does VER satisfy the constraint CONS
*   OP="STABILITY"  RESULT = dev|alpha|beta|rc|stable  the build's stability, read
*                   from its pre-release tag (mv_package#30 part 1).  Ranked
*                   dev < alpha < beta < rc < stable by the RANK op.
*   OP="RANK"  RESULT = 5..1 for the stability WORD in VER (stable rc beta alpha
*                   dev), and 0 for anything else.  Deliberately strict: callers
*                   use it to decide whether a typed word ("mvpkg install x@beta")
*                   IS a stability flag at all, so an arbitrary git ref or branch
*                   name must score 0 rather than being classified as a version.
*                   For a VERSION's rank, ask STABILITY first, then RANK the word.
* Versions: major.minor.patch[-prerelease].  A prerelease (1.2.0-beta.1) sorts
* BEFORE its release and is EXCLUDED by default (stable-only) unless the
* constraint itself names a prerelease.  Constraints: "" / "*" (any), exact
* "1.2.3", "^1.2.3", "~1.2.3", ">=/>/<=/</= X", "1.2.*", space-separated ranges.
   SUBROUTINE SEMVER(OP, VER, CONS, RESULT)
   BEGIN CASE
      CASE OP = "CMP" ; A = VER ; B = CONS ; GOSUB VCMP ; RESULT = CMP
      CASE OP = "SAT" ; GOSUB SATISFY ; RESULT = SAT
      CASE OP = "STABILITY" ; GOSUB STABILITY ; RESULT = STB
      CASE OP = "RANK" ; RWORD = OCONV(TRIM(VER), "MCL") ; GOSUB RANKW ; RESULT = RNK
      CASE 1 ; RESULT = ""
   END CASE
   RETURN
* STABILITY — classify VER's build stability from its pre-release tag: no
* pre-release is stable; otherwise the first dotted segment names the level
* (rc, beta/b, alpha/a, dev), any other pre-release treated as dev (least stable).
STABILITY:
   PVIN = VER ; GOSUB PARSE
   IF PPRE = "" THEN STB = "stable" ; RETURN
   FST = OCONV(FIELD(PPRE, ".", 1), "MCL")
   BEGIN CASE
      CASE FST[1, 2] = "rc"    ; STB = "rc"
      CASE FST[1, 4] = "beta"  ; STB = "beta"
      CASE FST[1, 5] = "alpha" ; STB = "alpha"
      CASE FST[1, 3] = "dev"   ; STB = "dev"
      CASE FST[1, 1] = "b"     ; STB = "beta"
      CASE FST[1, 1] = "a"     ; STB = "alpha"
      CASE 1                   ; STB = "dev"
   END CASE
   RETURN
* RANKW — rank the stability word in RWORD (already lower-cased), 0 if it is not
* one of the five.  The vocabulary is closed, which is what lets a spec suffix be
* read as a stability flag without colliding with a system name or a git ref.
RANKW:
   BEGIN CASE
      CASE RWORD = "stable" ; RNK = 5
      CASE RWORD = "rc"     ; RNK = 4
      CASE RWORD = "beta"   ; RNK = 3
      CASE RWORD = "alpha"  ; RNK = 2
      CASE RWORD = "dev"    ; RNK = 1
      CASE 1                ; RNK = 0
   END CASE
   RETURN
PARSE:
   V = TRIM(PVIN)
   IF V[1,1] = "v" OR V[1,1] = "V" THEN V = V[2, LEN(V)]
   DASH = INDEX(V, "-", 1)
   IF DASH > 0 THEN
      MAIN = V[1, DASH - 1] ; PPRE = V[DASH + 1, LEN(V)]
   END ELSE
      MAIN = V ; PPRE = ""
   END
   T1 = FIELD(MAIN, ".", 1) ; T2 = FIELD(MAIN, ".", 2) ; T3 = FIELD(MAIN, ".", 3)
   P1 = 0 ; IF T1 # "" AND NUM(T1) THEN P1 = T1 + 0
   P2 = 0 ; IF T2 # "" AND NUM(T2) THEN P2 = T2 + 0
   P3 = 0 ; IF T3 # "" AND NUM(T3) THEN P3 = T3 + 0
   RETURN
VCMP:
   PVIN = A ; GOSUB PARSE ; A1 = P1 ; A2 = P2 ; A3 = P3 ; APRE = PPRE
   PVIN = B ; GOSUB PARSE ; B1 = P1 ; B2 = P2 ; B3 = P3 ; BPRE = PPRE
   BEGIN CASE
      CASE A1 < B1 ; CMP = -1
      CASE A1 > B1 ; CMP = 1
      CASE A2 < B2 ; CMP = -1
      CASE A2 > B2 ; CMP = 1
      CASE A3 < B3 ; CMP = -1
      CASE A3 > B3 ; CMP = 1
      CASE APRE = "" AND BPRE = "" ; CMP = 0
      CASE APRE = "" ; CMP = 1
      CASE BPRE = "" ; CMP = -1
      CASE 1 ; GOSUB PRECMP
   END CASE
   RETURN
PRECMP:
   CMP = 0 ; NA = DCOUNT(APRE, ".") ; NB = DCOUNT(BPRE, ".")
   NMAX = NA ; IF NB > NMAX THEN NMAX = NB
   PI = 1
   LOOP WHILE PI <= NMAX AND CMP = 0 DO
      SA = FIELD(APRE, ".", PI) ; SB = FIELD(BPRE, ".", PI)
      BEGIN CASE
         CASE SA = "" ; CMP = -1
         CASE SB = "" ; CMP = 1
         CASE NUM(SA) AND NUM(SB)
            IF (SA + 0) < (SB + 0) THEN CMP = -1
            IF (SA + 0) > (SB + 0) THEN CMP = 1
         CASE SA < SB ; CMP = -1
         CASE SA > SB ; CMP = 1
      END CASE
      PI = PI + 1
   REPEAT
   RETURN
SATISFY:
   C = TRIM(CONS)
   * A trailing "@word" on the constraint is a MINIMUM-STABILITY FLOOR
   * (mv_package#30): "^1.2@beta" accepts 1.3.0-beta1, plain "^1.2" does not.
   * With no flag the floor is stable, which is the Composer rule this has
   * always applied -- so every existing caller keeps its exact behaviour.
   FRANK = 5
   ATC = INDEX(C, "@", 1)
   IF ATC > 0 THEN
      RWORD = OCONV(TRIM(C[ATC + 1, LEN(C)]), "MCL") ; GOSUB RANKW
      IF RNK > 0 THEN FRANK = RNK
      C = TRIM(C[1, ATC - 1])
   END
   * VER's own rank, compared against the floor wherever a pre-release would
   * otherwise be refused.  Computed once: it does not vary across the ranges.
   GOSUB STABILITY ; RWORD = STB ; GOSUB RANKW ; VRANK = RNK
   IF C = "" OR C = "*" THEN
      SAT = 0 ; IF VRANK >= FRANK THEN SAT = 1
      RETURN
   END
   SAT = 1
   FOR RI = 1 TO DCOUNT(C, " ")
      ONE = FIELD(C, " ", RI)
      IF ONE # "" THEN GOSUB SATONE ; IF S1 = 0 THEN SAT = 0
   NEXT RI
   RETURN
SATONE:
   S1 = 0 ; OPER = "=" ; OPND = ONE
   BEGIN CASE
      CASE ONE[1,1] = "^" ; OPER = "^"  ; OPND = ONE[2, LEN(ONE)]
      CASE ONE[1,1] = "~" ; OPER = "~"  ; OPND = ONE[2, LEN(ONE)]
      CASE ONE[1,2] = ">=" ; OPER = ">=" ; OPND = ONE[3, LEN(ONE)]
      CASE ONE[1,2] = "<=" ; OPER = "<=" ; OPND = ONE[3, LEN(ONE)]
      CASE ONE[1,1] = ">" ; OPER = ">"  ; OPND = ONE[2, LEN(ONE)]
      CASE ONE[1,1] = "<" ; OPER = "<"  ; OPND = ONE[2, LEN(ONE)]
      CASE ONE[1,1] = "=" ; OPER = "="  ; OPND = ONE[2, LEN(ONE)]
      CASE INDEX(ONE, "*", 1) > 0 ; OPER = "W" ; OPND = ONE
      CASE 1 ; OPER = "=" ; OPND = ONE
   END CASE
   OPND = TRIM(OPND)
   PVIN = VER ; GOSUB PARSE ; VPRE = PPRE
   PVIN = OPND ; GOSUB PARSE ; OPRE = PPRE
   * A pre-release satisfies a stable constraint only when the floor allows it.
   * Below the floor -- and, with no floor, for every pre-release -- S1 stays 0.
   IF VPRE # "" AND OPRE = "" THEN
      IF VRANK < FRANK THEN RETURN
   END
   BEGIN CASE
      CASE OPER = "="  ; A = VER ; B = OPND ; GOSUB VCMP ; IF CMP = 0 THEN S1 = 1
      CASE OPER = ">=" ; A = VER ; B = OPND ; GOSUB VCMP ; IF CMP >= 0 THEN S1 = 1
      CASE OPER = ">"  ; A = VER ; B = OPND ; GOSUB VCMP ; IF CMP > 0 THEN S1 = 1
      CASE OPER = "<=" ; A = VER ; B = OPND ; GOSUB VCMP ; IF CMP <= 0 THEN S1 = 1
      CASE OPER = "<"  ; A = VER ; B = OPND ; GOSUB VCMP ; IF CMP < 0 THEN S1 = 1
      CASE OPER = "^"  ; GOSUB CARET
      CASE OPER = "~"  ; GOSUB TILDE
      CASE OPER = "W"  ; GOSUB WILD
   END CASE
   RETURN
* A DERIVED BOUND IS A BOUND ON THE RELEASE, NOT ON ITS PRE-RELEASES.  ^1.0 and
* ~1.0 invent both ends of their range, and a pre-release compares BELOW the
* release it leads to -- so a literal comparison puts 2.0.0-rc1 inside ^1.0 (it
* is less than 2.0.0) and puts 1.0.0-beta1 outside it (it is less than 1.0.0).
* Both are wrong: the caller named a major line, not a point in the ordering.
* Comparing VER's release part against a derived bound gives Composer's reading
* (">=1.0.0-dev <2.0.0-dev").  An OPND that names a pre-release itself is a
* deliberate point in the ordering, so that one is compared in full.
* Only reachable for a pre-release VER when a stability floor let it through.
MAINOF:
   PVIN = VER ; GOSUB PARSE
   VMAIN = P1 : "." : P2 : "." : P3
   RETURN
CARET:
   PVIN = OPND ; GOSUB PARSE ; OM = P1 ; ONN = P2 ; OPT = P3
   GOSUB MAINOF
   LOA = VMAIN ; IF OPRE # "" THEN LOA = VER
   A = LOA ; B = OPND ; GOSUB VCMP ; LO = 0 ; IF CMP >= 0 THEN LO = 1
   BEGIN CASE
      CASE OM > 0 ; HIV = (OM + 1) : ".0.0"
      CASE ONN > 0 ; HIV = "0." : (ONN + 1) : ".0"
      CASE 1 ; HIV = "0.0." : (OPT + 1)
   END CASE
   A = VMAIN ; B = HIV ; GOSUB VCMP ; HI = 0 ; IF CMP < 0 THEN HI = 1
   IF LO AND HI THEN S1 = 1
   RETURN
TILDE:
   PVIN = OPND ; GOSUB PARSE ; OM = P1 ; ONN = P2
   GOSUB MAINOF
   LOA = VMAIN ; IF OPRE # "" THEN LOA = VER
   A = LOA ; B = OPND ; GOSUB VCMP ; LO = 0 ; IF CMP >= 0 THEN LO = 1
   HIV = OM : "." : (ONN + 1) : ".0"
   A = VMAIN ; B = HIV ; GOSUB VCMP ; HI = 0 ; IF CMP < 0 THEN HI = 1
   IF LO AND HI THEN S1 = 1
   RETURN
WILD:
   STAR = INDEX(OPND, "*", 1) ; PFX = OPND[1, STAR - 1]
   IF PFX[LEN(PFX), 1] = "." THEN PFX = PFX[1, LEN(PFX) - 1]
   NPF = DCOUNT(PFX, ".")
   PVIN = VER ; GOSUB PARSE ; VA = P1 ; VB = P2 ; VC = P3
   MOK = 1
   IF NPF >= 1 THEN
      IF (FIELD(PFX, ".", 1) + 0) # VA THEN MOK = 0
   END
   IF NPF >= 2 THEN
      IF (FIELD(PFX, ".", 2) + 0) # VB THEN MOK = 0
   END
   IF NPF >= 3 THEN
      IF (FIELD(PFX, ".", 3) + 0) # VC THEN MOK = 0
   END
   S1 = MOK
   RETURN