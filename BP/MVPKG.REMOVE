* mv_package — MVPKG subcommand: remove.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG remove <name> — uninstall a package: un-deploy it from this account,
* drop the store copy, and clear it from the system inventory, this account's
* lock and its manifest.  The inverse of install.  Only the un-deploy step
* differs by platform: MVX unlinks the whole package (UNLINK-PKG, which refuses
* if another linked package still depends on it); UniData un-deploys the
* mvpkg.json verbs, decatalogs the code and unstages any CallC contribution.
   SUBROUTINE MVPKG.REMOVE
$IFDEF MVX
   S = SENTENCE()
$ELSE
   S = @SENTENCE
$ENDIF
   A1 = FIELD(S, " ", 3)
   IF A1 = "" THEN PRINT "usage: MVPKG remove <name> [--force]" ; RETURN
   NM = A1
   CALL MVPKGOS("STORE", "", "", STORE)
   PKGKEY = CHANGE(NM, "/", "_")
   DEST = STORE : "/" : PKGKEY
   * is it in the SYSTEM store? (MVPKG.STORE "installed" <2> names)
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   INST = 0
   LOCATE(NM, SREC, 2; SPOS) THEN INST = 1
   IF INST = 0 THEN PRINT NM : " is not installed" ; RETURN
* WHAT STILL NEEDS IT?  Asked BEFORE anything is deleted, because the answer
* stops being recoverable the moment the store copy goes: removing getopt on a
* working account took cmd's GETOPT.SENTENCE with it and left MVPKG unable to
* dispatch its own commands, with the failure reported from inside the
* dependent rather than at the thing that caused it (#98).  MVX has refused
* this since it linked packages; the MV vendors did not.
   RFORCE = 0
   FOR FI = 3 TO DCOUNT(S, " ")
      IF FIELD(S, " ", FI) = "--force" THEN RFORCE = 1
   NEXT FI
   CALL MVPKG.RDEPS(NM, RHARD, RSOFT, RPROV)
   IF RHARD # "" AND RFORCE = 0 THEN
      PRINT NM : " is still required by: " : RHARD
      PRINT "  removing it would break them: their code is cataloged against"
      PRINT "  this package's store copy, which this would delete."
      PRINT "  remove those first, or  MVPKG remove " : NM : " --force"
      RETURN
   END
   IF RHARD # "" THEN PRINT "mvpkg: --force — removing anyway; this breaks: " : RHARD
   IF RSOFT # "" THEN PRINT "mvpkg: optional for: " : RSOFT : " (they guard its absence)"
   PRINT "removing " : NM : " ..."
   * ---- un-deploy from this account + drop the store copy (deploy model) ----
$IFDEF MVX
   CALL MVPKGOS("UNLINK", DEST, "", ERR) ; IF ERR # "" THEN PRINT ERR
   CALL MVPKGOS("RMRF", DEST, "", ERR)
$ELSE
   * #33: un-deploy exactly the verbs THIS install laid down here, from the pinned
   * footprint in MVPKG.LOCK<7> (an @SM list of "V <verb>" / "F <name>:<type>") —
   * not whatever the store manifest now says, which a version change may have
   * altered.  Fall back to the store manifest deploy block for a package installed
   * before the footprint was recorded (an empty <7>).  Files are recorded but not
   * removed — they hold account data.
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", LREC)
   FTP = "" ; LOCATE(NM, LREC, 2; LPOS) THEN FTP = LREC<7,LPOS>
   DVERBS = ""
   IF FTP # "" THEN
      FOR I = 1 TO DCOUNT(FTP, @SM)
         ART = FTP<1,1,I>
         IF ART[1,1] = "V" THEN
            VN = TRIM(ART[3, LEN(ART)])
            IF VN # "" THEN DVERBS := VN : " "
         END
      NEXT I
   END ELSE
      CALL MVPKG.FILE("READ", DEST : "/mvpkg.json", MJ, MVFOK)
      CALL MVPKGDEP(MJ, DVERBS, DFILES, DFALL)
   END
   FOR I = 1 TO DCOUNT(DVERBS, " ")
      V = FIELD(DVERBS, " ", I)
      IF V # "" THEN CALL MVPKGOS("UNVERB", V, "", ERR) ; IF ERR # "" THEN PRINT ERR
   NEXT I
   * decatalog the programs, unstage the CallC contribution, drop the store copy
   CALL MVPKGOS("DECAT", DEST, "BP", ERR) ; IF ERR # "" THEN PRINT ERR
   * only a package that shipped a udt-callc/ contribution needs the library
   * rebuilt (avoid a pointless rebuild for pure-BASIC packages).
   HASCC = 0
   CALL MVPKG.FILE("READ", DEST : "/udt-callc/funcs", CCF, MVFOK)
   IF MVFOK THEN HASCC = 1 ELSE HASCC = 0
   IF HASCC THEN CALL MVPKGOS("CALLCRM", PKGKEY, "", ERR) ; IF ERR # "" THEN PRINT ERR
   CALL MVPKGOS("RMDIR", DEST, "", ERR)
$ENDIF
   * drop it from the SYSTEM store inventory (name + parallel version)
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   LOCATE(NM, SREC, 2; SPOS) THEN
      * the version that is leaving, read before the record forgets it
      TKVER = TRIM(SREC<3,SPOS>)
      SREC = DELETE(SREC, 2, SPOS, 0)
      SREC = DELETE(SREC, 3, SPOS, 0)
      CALL MVPKGOS("STOREWRITE", "installed", SREC, SERR)
      * The SYSTEM store changed.  Only here -- undeploying from an account
      * leaves the package installed on the machine and is not a removal.
      CALL MVPKG.TRACK("remove", NM, TKVER, "")
   END
   * drop the source working-copy marker too, if any
   CALL MVPKGOS("STOREDELETE", "SRC." : PKGKEY, "", SERR)
   * drop it from this account's lock (the MVPKG.LOCK record), name + version
   *
   * AND THE NAMES IT PROVIDED WITH IT.  The lock records a package and each
   * virtual name it satisfies (#81); dropping only the package left the alias
   * behind, so "getopt" stayed in a lock whose mvx-lang/getopt was gone and a
   * later resolve could believe the name was satisfied when nothing provided
   * it.  The store copy is still there to read at this point -- the RMDIR above
   * removed it, so RDEPS read the provides list earlier and it is in RNAMES.
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", IREC)
   NREC = "MVPKG-LOCK"
   NJ = 0
   FOR I = 1 TO DCOUNT(IREC<2>, @VM)
      MLN = TRIM(IREC<2,I>)
      MLDROP = 0
      IF MLN = NM THEN MLDROP = 1
      FOR PVI = 1 TO DCOUNT(RPROV, " ")
         IF MLN # "" AND MLN = FIELD(RPROV, " ", PVI) THEN MLDROP = 1
      NEXT PVI
      IF MLN # "" AND MLDROP = 0 THEN
         NJ = NJ + 1
         NREC<2,NJ> = MLN
         NREC<3,NJ> = IREC<3,I>
      END
   NEXT I
   CALL MVPKGOS("MDWRITE", "MVPKG.LOCK", NREC, IERR)
   * un-declare it from the manifest too (composer remove), matched by the name
   * part of each dep spec "[?]name[@sys][:constraint]" — a no-op if it was only
   * a transitive dep and never declared.
   CALL MVPKGOS("MDREAD", "MVPKG.MANIFEST", "", MREC)
   NMR = "MVPKG-MANIFEST"
   MJ2 = 0
   FOR I = 1 TO DCOUNT(MREC<2>, @VM)
      SP = TRIM(MREC<2,I>)
      IF SP # "" THEN
         SN = SP
         IF SN[1,1] = "?" THEN SN = SN[2, LEN(SN)]
         CP = INDEX(SN, ":", 1) ; IF CP > 0 THEN SN = SN[1, CP - 1]
         AP = INDEX(SN, "@", 1) ; IF AP > 0 THEN SN = SN[1, AP - 1]
         IF SN # NM THEN MJ2 = MJ2 + 1 ; NMR<2,MJ2> = SP
      END
   NEXT I
   CALL MVPKGOS("MDWRITE", "MVPKG.MANIFEST", NMR, MERR)
   PRINT "removed " : NM
   RETURN
