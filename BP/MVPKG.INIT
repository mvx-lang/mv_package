* mv_package — MVPKG subcommand: init.
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG init [<registry-url>] — provision the current account for package
* management.  The "run this first in a new account" step, analogous to
* `git init`: it records the registry URL (if one is given), ensures the
* global package store and the account's install manifest exist, and reports
* the environment.  Idempotent and safe to rerun.
*
* It does not itself install MVPKG — MVPKG must already be resolvable to type
* this.  Initial availability comes from the global/bootstrap install (or a
* manual LINK-PKG); init prepares an account to use it.
   SUBROUTINE MVPKG.INIT
$IFDEF MVX
$DEFINE GETENV ENV
   S = SENTENCE()
$ELSE
   S = @SENTENCE
$ENDIF
   A1 = FIELD(S, " ", 3)

   * INIT mutates THIS account (adds the store + MVPKG.INC pointers, the lock and
   * composer, writes PLATFORM.H), so confirm before touching it.  -y / --yes
   * skips the prompt for scripted installs.
   YES = 0
   IF INDEX(S, " -y", 1) # 0 OR INDEX(S, " --yes", 1) # 0 THEN YES = 1
   IF A1 = "-y" OR A1 = "--yes" THEN A1 = ""
   IF NOT(YES) THEN
$IFDEF MVX
      HEREACC = GETENV("MVXACCOUNT") ; IF HEREACC = "" THEN HEREACC = "."
$ELSE
      HEREACC = @PATH
$ENDIF
      PRINT "Initialise mvpkg in this account?"
      PRINT "  " : HEREACC
      PRINT "This adds the store + MVPKG.INC pointers, the lock, and PLATFORM.H here."
      PRINT "Continue? (y/N) " :
      INPUT ANS
      IF OCONV(ANS[1, 1], "MCU") # "Y" THEN
         PRINT "aborted — nothing changed"
         RETURN
      END
   END

   * record the registry if a URL was supplied (persisted where MVPKG.REG reads
   * it back): MVX writes account-relative with the function OSWRITE, UniData
   * writes ~/mvpkg.conf with the statement form.
   IF A1 # "" THEN
$IFDEF MVX
      CONF = GETENV("MVXACCOUNT")
      IF CONF = "" THEN CONF = "."
      CONF = CONF : "/mvpkg.conf"
      IF NOT(OSWRITE(A1, CONF)) THEN PRINT "cannot write config " : CONF ; RETURN
$ELSE
      CONF = GETENV("HOME") : "/mvpkg.conf"
      OSWRITE A1 ON CONF
$ENDIF
   END

   CALL MVPKG.REG(REG)
   CALL MVPKGOS("STORE", "", "", STORE)

   * ensure the account's installed set exists (empty is fine) — a native
   * master-dictionary record (MVPKG.LOCK), not an OS file
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", IREC)
   IF IREC = "" THEN CALL MVPKGOS("MDWRITE", "MVPKG.LOCK", "MVPKG-LOCK", IERR)

   * provision MVPKG.INC / PLATFORM.H — the platform-defines include every managed
   * package compiles against ($INCLUDE MVPKG.INC PLATFORM.H): getopt, cmd, …
   CALL MVPKGOS("INCSETUP", "", "", INCERR)
   IF INCERR # "" THEN PRINT INCERR

   PRINT "mvpkg initialised"
   PRINT "  registry: " : REG
   PRINT "  store:    " : STORE
   PRINT "  include:  MVPKG.INC/PLATFORM.H"
   PRINT "install packages with:  MVPKG install <name>"
   RETURN