# .mv-account - open (portable) account descriptor
name = mv_package
version = 1
openaccount = 1
hash = lmdb
# THE VENDOR PERMIT IS NOT HERE, it is in .mvx (#183).  mvx reads grants from
# <account>/.mvx, <account>/.mvx-private/permissions and the system layer, and
# never from this file -- so a permit written here is not policy, it is a
# comment.  `permit' is an mvx concept anyway; no other MV platform has the
# gate, which is why the MVX descriptor is the right home for it.
