{
  "name": "mvx-lang/mvpkg",
  "version": "1.15.0",
  "description": "MVPKG — the MultiValue package manager client",
  "license": "GPL-2.0-only",
  "systems": ["mvx", "udt"],
  "dependencies": ["mvx-lang/http@mvx", "curl@!mvx", "mvx-lang/json@!mvx", "?mvx-lang/cmd", "?mvx-lang/git"],
