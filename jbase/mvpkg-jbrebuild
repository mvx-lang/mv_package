#!/bin/sh
# mvpkg-jbrebuild — rebuild the MVPKG client's shared object library on jBASE.
# Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see ../LICENSE).
#
#   mvpkg-jbrebuild [<account-dir>]     rebuild from that account's BP (default: .)
#
# WHY THIS IS A SHELL SCRIPT AND NOT AN MVPKG SUBCOMMAND.  jBASE catalogs into
# ONE shared library per USER, $HOME/lib/lib0.so, so every program a user
# catalogs lands in the same object.  A program in it whose DEFC names a symbol
# the loader cannot find makes the WHOLE library unloadable -- and because it is
# per user rather than per account, every account on the machine stops at once:
#
#     jbstable   jBASE: /home/rocky/lib/lib0.so.84: undefined symbol: JBCURLPOST
#     jbrel      jBASE: /home/rocky/lib/lib0.so.84: undefined symbol: JBCURLPOST
#     jbtest     jBASE: /home/rocky/lib/lib0.so.84: undefined symbol: JBCURLPOST
#
# MVPKG's own subroutines live in that library.  Every MVPKG command therefore
# fails with SUBROUTINE_CALL_FAIL before it can do anything, so a repair driven
# through MVPKG cannot repair this -- `MVPKG rebuild` included.  It has to be
# reachable WITHOUT MVPKG, which is why it lives here beside mvpkg-jblib in the
# store, one per system, and is plain shell and jsh.
#
# #62 gave each package its own JBCDEV_LIB directory so package programs stop
# landing in $HOME/lib.  That prevents new occurrences; it does nothing for a
# machine that already has one, and nothing for a package installed before it.
#
# WHAT IT REMOVES, and what it deliberately does not.  Only the catalog objects
# lib0.so* and lib.el are dropped and rebuilt.  jLibDefinition and any native
# library a package installed (libjbcurl.so and friends) are left alone -- they
# are not the catalog and rebuilding does not produce them.
#
# A PACKAGE CATALOGED INTO $HOME/lib BY AN OLD MVPKG DOES NOT COME BACK.  That is
# the point: those entries are what break the library.  Re-deploy such a package
# afterwards (MVPKG install <name>) and it lands in its own directory this time.
set -eu

ACCT="${1:-$PWD}"
say()  { printf 'mvpkg-jbrebuild: %s\n' "$1"; }
die()  { printf 'mvpkg-jbrebuild: %s\n' "$1" >&2; exit 1; }

command -v jsh >/dev/null 2>&1 || die "jsh is not on PATH — source jbase_env.sh first"
[ -d "$ACCT/BP" ] || die "$ACCT has no BP directory — run this from an MVPKG account, or pass one"
[ -n "${HOME:-}" ] || die "\$HOME is not set"

LIB="${JBCDEV_LIB:-$HOME/lib}"
say "rebuilding $LIB from $ACCT/BP"

# The programs to rebuild: every BP item that is a source, skipping jBASE's own
# compiled objects ($NAME) and dotfiles.
PROGS="$(cd "$ACCT/BP" && for f in *; do
   [ -f "$f" ] || continue
   case "$f" in \$*|.*|_*) continue ;; esac
   printf '%s ' "$f"
done)"
[ -n "$PROGS" ] || die "$ACCT/BP has no programs to compile"

# COMPILE EVERYTHING FIRST, and only then clear the library.  BASIC writes to
# the account's object area; CATALOG is what writes the library.  Doing it the
# other way round -- clear, then compile-and-catalog in one pass -- means a
# compile that fails for any reason at all leaves NO library, which is a worse
# place than the broken one this started from.  That is not hypothetical: it is
# what this script did the first time it was run from somewhere the jBASE
# environment was not fully set, and it took the account down.
FAILED=
for p in $PROGS; do
   ( cd "$ACCT" && printf 'BASIC BP %s\n' "$p" | jsh 2>&1 ) | grep -q "compiled successfully" \
      || FAILED="$FAILED $p"
done
[ -z "$FAILED" ] || die "compile failed, library left alone:$FAILED"
say "compiled $(printf '%s' "$PROGS" | wc -w | tr -d ' ') program(s)"

rm -f "$LIB"/lib0.so* "$LIB"/lib.el
say "cleared the catalog objects"

for p in $PROGS; do
   ( cd "$ACCT" && printf 'CATALOG BP %s\n' "$p" | jsh ) >/dev/null 2>&1 || true
done

# ASSERT THE POSITIVE FACT, not the absence of complaints.  jsh reports a failed
# CATALOG on stdout and still exits 0, and -- the part that matters here -- an
# unresolved symbol is invisible until something tries to LOAD the library.  So
# load it: run a real MVPKG command and require it to answer.
#
# Not `nm` on the object.  lib0.so legitimately carries many undefined symbols
# that the jBASE host resolves at load, so telling a fatal one from an ordinary
# one means knowing which names the host provides -- a list this script would
# have to keep correct.  Loading the library asks the loader instead, which is
# the only thing whose opinion counts.
[ -x "$HOME/bin/MVPKG" ] || die "no $HOME/bin/MVPKG after cataloging — is \$HOME/bin writable?"
# `MVPKG list`, and not something cheaper.  jBASE loads a subroutine on first
# CALL, so a command CMD.RUN rejects before it dispatches -- an unknown one, or
# a usage error -- never touches the library and answers happily while it is
# broken.  list CALLs MVPKG.LIST, which is the point.
out="$( cd "$ACCT" && printf 'MVPKG list\n' | jsh 2>&1 || true )"
case "$out" in
   *"undefined symbol"*|*SUBROUTINE_CALL_FAIL*)
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      die "$LIB still does not load — a package program is cataloged there; remove it from $ACCT/BP and re-run" ;;
esac
say "rebuilt; MVPKG loads again"
