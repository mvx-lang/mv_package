#!/usr/bin/env python3
# mvpkg-deploy — flatten a package's mvpkg.json "deploy" block for the MVPKG
# UniData client, whose JSON seam is flat.  Given the package directory as
# argv[1], prints three lines:
#   1. verbs               space-separated
#   2. files               space-separated  name:type
#   3. fallback            space-separated  dir:representative-program
#      (representative = the first program the dir provides, so the client can
#       skip the dir when that program is already cataloged)
# Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only.
import json, os, sys

base = sys.argv[1] if len(sys.argv) > 1 else "."
try:
    deploy = json.load(open(os.path.join(base, "mvpkg.json"))).get("deploy", {})
except Exception:
    deploy = {}

print(" ".join(deploy.get("verbs", [])))
print(" ".join(f["name"] + ":" + f.get("type", "") for f in deploy.get("files", [])))

pairs = []
for dep, dirs in deploy.get("fallback", {}).items():
    for d in dirs:
        p = os.path.join(base, d)
        items = [y for y in sorted(os.listdir(p)) if y[:1] not in ("_", ".")] if os.path.isdir(p) else []
        pairs.append(d + ":" + (items[0] if items else ""))
print(" ".join(pairs))
