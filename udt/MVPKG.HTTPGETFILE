FUNCTION MVPKG.HTTPGETFILE(URL, PATH)
* mv_package UniData seam — download URL to PATH, return the HTTP status.
* GPL-2.0-only.
   CF = "/tmp/mvpkg_code.tmp"
   * -L follows redirects: a GitHub release-asset URL 302s to the CDN, and the
   * registry indexes exactly those external asset URLs.  %{http_code} then
   * reports the final status (200), not the 302.
   CALL MVPKG.SH('curl -sL -o "' : PATH : '" -w "%{http_code}" "' : URL : '" > ' : CF, MVSHOUT, MVSHST)
   CODE = ""
   CALL MVPKG.FILE("READ", CF, CODE, MVFOK)
   IF NOT(MVFOK) THEN CODE = "0"
   CALL MVPKG.SH('rm -f ' : CF, MVSHOUT, MVSHST)
   RETURN(CODE + 0)
