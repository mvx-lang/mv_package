* mv_package — MVPKG helper: install one already-resolved package (UniData).
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG.ONE(META, REG) — install the single package described by META (as
* returned by MVPKG.META).  Two tiers.  GLOBAL (once per system): download
* the release into the store, globally catalog its code, record it in the
* store manifest.  ACCOUNT (every run): deploy the verbs + files into the
* current account.  So `MVPKG install` rerun in another account downloads
* nothing — it just links the package up.
*
* UniData deploy path (differs from MVX's LINK-PKG): the seam CATALOG op
* compiles + globally catalogs the code, VERB deploys per-account VOC
* pointers, MKFILE creates declared account files; the mvpkg.json deploy
* block is walked by MVPKGDEP.
   SUBROUTINE MVPKG.ONE(META, REG, RESULT)
   DEFFUN HTTPGETFILE(A, B)
   * RESULT is "" on success, else a short reason — the caller must NOT record the
   * package as installed when it is non-empty (a failed install used to still be
   * written to the account manifest, so a retry saw it as done and silently
   * skipped it).
   RESULT = ""
   CALL MVPKGOS("STORE", "", "", STORE)
   * Never act on empty metadata: a blank name would make DEST the store ROOT,
   * so a later rm/untar would target the whole store.  Callers should have
   * caught a registry miss (MVPKG.META returns "" for one), but guard here too.
   IF TRIM(META<1>) = "" THEN RESULT = "empty package metadata" ; PRINT "mvpkg: " : RESULT : " — skipping" ; RETURN
   PKGKEY = CHANGE(META<1>, "/", "_")
   * Preflight the OS C libraries the package declares (META<9>): if any are
   * absent, stop with a clear message BEFORE the CallC fold hits a cryptic
   * linker error.  This replaces per-package install.sh library preflights.
   GOSUB CLIBCHECK
   IF CLIBMISS # "" THEN
      RESULT = "missing OS C libraries: " : TRIM(CLIBMISS)
      PRINT META<1> : ": needs OS C libraries not found: " : TRIM(CLIBMISS)
      PRINT "  install the OS package(s) providing them, then re-run."
      RETURN
   END
   * --source: build + deploy directly from a git working copy (its path in
   * META<20>) through the SAME declarative path as a binary install — fold the
   * native CallC contribution, globally catalog the code, deploy the mvpkg.json
   * verbs + files.  No download, no store manifest (MVPKG install --source
   * records the working copy), and NO package script — the fixed set of MVPKGOS
   * operations is the one trusted install path everything goes through.
   SRCDIR = TRIM(META<20>)
   IF SRCDIR # "" THEN
      DEST = SRCDIR
      CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      GOSUB PARSEDEPLOY
      GOSUB CATGLOBAL
      GOSUB DEPLOYACCT
      RETURN
   END
   DEST = STORE : "/" : PKGKEY
   GMAN = STORE : "/installed"
   GKEY = META<1> : " " : META<2>
   OSREAD GTEXT FROM GMAN ELSE GTEXT = ""
   GINST = 0
   NG = DCOUNT(GTEXT, CHAR(10))
   FOR GI = 1 TO NG
      IF TRIM(FIELD(GTEXT, CHAR(10), GI)) = GKEY THEN GINST = 1
   NEXT GI
   IF GINST = 0 THEN
      TMP = "/tmp/mvpkg_" : PKGKEY : ".tar.gz"
      PRINT "fetching " : META<1> : " " : META<2> : " ..."
      * registry-hosted (relative) or an external http(s) URL (a binary-only
      * package served from a vendor site or GitHub) — absolute is used as-is.
      TURL = META<3>
      IF TURL[1, 4] # "http" THEN TURL = REG : TURL
      ST = HTTPGETFILE(TURL, TMP)
      IF ST < 200 OR ST >= 300 THEN RESULT = "download failed (status " : ST : ")" ; PRINT RESULT ; RETURN
      EXECUTE '!rm -rf "' : DEST : '"'
      CALL MVPKGOS("UNTAR", TMP, DEST, ERR)
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      EXECUTE '!rm -f "' : TMP : '"'
      CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
      * A failed native fold must abort BEFORE cataloging — otherwise the
      * package's verbs (e.g. HTTPGET) get cataloged over working ones with no
      * CallC backend behind them.  The store manifest is not written yet, so the
      * package is simply left uninstalled; fix the toolchain and re-run.
      IF ERR # "" THEN RESULT = ERR ; PRINT ERR ; RETURN
      GOSUB PARSEDEPLOY
      GOSUB CATGLOBAL
      IF GTEXT # "" AND GTEXT[LEN(GTEXT), 1] # CHAR(10) THEN GTEXT := CHAR(10)
      GTEXT := GKEY : CHAR(10)
      OSWRITE GTEXT ON GMAN
      PRINT "installed " : META<1> : " " : META<2> : " (globally cataloged)"
   END ELSE
      GOSUB PARSEDEPLOY
      PRINT META<1> : " " : META<2> : " already installed — deploying here"
   END
   GOSUB DEPLOYACCT
   RETURN

* --- flatten the mvpkg.json "deploy" block in BASIC (no shell/python) -------
* MVPKGDEP walks the nested block (the flat JSON seam only reads flat strings),
* yielding space-separated DVERBS, DFILES ("name:type"), DFALL ("dep:dir").
PARSEDEPLOY:
   OSREAD MJ FROM DEST : "/mvpkg.json" ELSE MJ = ""
   CALL MVPKGDEP(MJ, DVERBS, DFILES, DFALL)
   RETURN

* --- GLOBAL: compile + globally catalog the code (once per system) ----------
CATGLOBAL:
   PRINT "cataloging " : META<1> : " ..."
   CALL MVPKGOS("CATALOG", DEST, "BP", ERR) ; IF ERR # "" THEN PRINT ERR
   * fallback dirs: catalog each only when its programs aren't already there.
   NF = DCOUNT(DFALL, " ")
   FOR I = 1 TO NF
      PR = FIELD(DFALL, " ", I)
      FBD = FIELD(PR, ":", 2)
      IF FBD # "" THEN CALL MVPKGOS("CATIFNEW", DEST, FBD, ERR)
   NEXT I
   RETURN

* --- ACCOUNT: deploy the verbs + files into the current account -------------
DEPLOYACCT:
   NV = DCOUNT(DVERBS, " ")
   FOR I = 1 TO NV
      V = FIELD(DVERBS, " ", I)
      IF V # "" THEN CALL MVPKGOS("VERB", V, "", ERR) ; IF ERR # "" THEN PRINT ERR
   NEXT I
   NFI = DCOUNT(DFILES, " ")
   FOR I = 1 TO NFI
      FT = FIELD(DFILES, " ", I)
      IF FT # "" THEN
         FNM = FIELD(FT, ":", 1) ; FTY = FIELD(FT, ":", 2)
         CALL MVPKGOS("MKFILE", FNM, FTY, ERR)
      END
   NEXT I
   PRINT "deployed " : META<1> : " into this account"
   RETURN

* --- preflight declared OS C libraries -------------------------------------
* CLIBCHECK — a package declares in its mvpkg.json the OS C libraries its CallC
* links (META<9>, space-separated).  Each entry is one of:
*   libcurl.so.4                     an exact soname
*   libgit2.so.1.7|libgit2.so.1.9    alternatives — ANY present satisfies it
*   libgit2.so:>=1.7,<2.8            a base soname + a SEMVER range over the
*                                    version suffix (libgit2 churns its soname by
*                                    distro: 1.7 on EPEL, 1.9 upstream)
* The requirement is met if the cache has a match; CLIBMISS collects any entry
* that has none, so the install stops with a clear message rather than a cryptic
* linker failure deep in the fold.
CLIBCHECK:
   CLIBMISS = ""
   CLIBS = TRIM(META<9>)
   IF CLIBS = "" THEN RETURN
   TMPF = "/tmp/mvpkg_ldc_" : @USERNO
   EXECUTE '!ldconfig -p > "' : TMPF : '" 2>/dev/null'
   OSREAD LDC FROM TMPF ELSE LDC = ""
   EXECUTE '!rm -f "' : TMPF : '"'
   NLC = DCOUNT(LDC, CHAR(10))
   FOR CI = 1 TO DCOUNT(CLIBS, " ")
      LB = FIELD(CLIBS, " ", CI)
      IF LB # "" THEN
         HIT = 0
         COLON = INDEX(LB, ":", 1)
         IF COLON > 0 THEN
            SOBASE = LB[1, COLON - 1]
            CONS = CHANGE(LB[COLON + 1, LEN(LB)], ",", " ")
            GOSUB CLIBRANGE
         END ELSE
            FOR AI = 1 TO DCOUNT(LB, "|")
               ALT = FIELD(LB, "|", AI)
               IF ALT # "" AND INDEX(LDC, ALT, 1) > 0 THEN HIT = 1
            NEXT AI
         END
         IF HIT = 0 THEN CLIBMISS := LB : " "
      END
   NEXT CI
   RETURN

* CLIBRANGE — is any installed "<SOBASE>.<version>" soname satisfying CONS (a
* space-separated SEMVER range)?  Scan ldconfig lines for SOBASE., pull the
* version suffix, and test it with the same SEMVER used for package constraints.
CLIBRANGE:
   HIT = 0
   FOR LI = 1 TO NLC
      LNL = FIELD(LDC, CHAR(10), LI)
      P = INDEX(LNL, SOBASE : ".", 1)
      IF P > 0 THEN
         VS = LNL[P + LEN(SOBASE) + 1, LEN(LNL)]
         VER = ""
         DONEV = 0
         FOR VI = 1 TO LEN(VS)
            C = VS[VI, 1]
            IF DONEV = 0 THEN
               IF C = " " OR C = "(" OR C = CHAR(9) THEN DONEV = 1 ELSE VER := C
            END
         NEXT VI
         IF VER # "" THEN
            CALL SEMVER("SAT", VER, CONS, SR)
            IF SR = 1 THEN HIT = 1
         END
      END
   NEXT LI
   RETURN
