* mv_package — MVPKG, the MultiValue package manager client (UniData port).
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* Same behaviour as the portable BP/MVPKG: resolve a package from the
* registry, download its release tar and install it into an account —
* pulling in its dependencies first.  The portable client reaches HTTP and
* JSON as intrinsics (the MVX http/json extensions); UniData has neither, so
* this port declares them as the cataloged seam functions (udt/HTTPGET,
* HTTPGETFILE, JSONDECODE, MAPFIELD) and uses UniData idioms (GETENV, OSREAD/
* OSWRITE statements, @SENTENCE for args).
*
*   MVPKG install <name> [<dest>]   install a package and its dependencies
*   MVPKG info <name>               show a package's registry metadata
*   MVPKG config                    show the current registry URL
*
* Installing shells out (curl, tar, the native rebuild), so it needs the
* privilege to do so.  A package that carries a udt-callc/ contribution
* rebuilds the shared CallC library (via MVPKGOS "CALLC") when installed.
* Installed package names are recorded in mvpkg.installed in the account, so
* a dependency already present is not reinstalled.
   DEFFUN HTTPGET(A)
   DEFFUN HTTPGETFILE(A, B)
   DEFFUN JSONDECODE(A, B)
   DEFFUN MAPFIELD(A, B)

   S = @SENTENCE
   CMD = OCONV(FIELD(S, " ", 2), "MCL")
   A1 = FIELD(S, " ", 3)
   A2 = FIELD(S, " ", 4)

   DEFURL = "https://mv-package.heydon.io"
   CONF = GETENV("HOME") : "/mvpkg.conf"
   MFILE = "mvpkg.installed"

   GOSUB GETREG
   BEGIN CASE
      CASE CMD = "install"  ; GOSUB INSTALL
      CASE CMD = "info"     ; GOSUB INFO
      CASE CMD = "list"     ; GOSUB LIST
      CASE CMD = "register" ; GOSUB REGISTER
      CASE CMD = "config"   ; PRINT "registry: " : REG
      CASE 1                ; GOSUB USAGE
   END CASE
   STOP

* --- resolve the registry base URL -------------------------------------
GETREG:
   REG = GETENV("MVPKG_REGISTRY")
   IF REG = "" THEN
      OSREAD REG FROM CONF ELSE REG = ""
      REG = TRIM(REG, CHAR(10), "T")
   END
   IF REG = "" THEN REG = DEFURL
   RETURN

* --- fetch + decode package NAME (in variable FM) into META -------------
* META<1>=name <2>=version <3>=tarball <4>=description <5>=deps (space-sep).
FETCHMETA:
   SPEC = ""
   SPEC<-1> = MAPFIELD("name", 1)
   SPEC<-1> = MAPFIELD("version", 2)
   SPEC<-1> = MAPFIELD("tarball", 3)
   SPEC<-1> = MAPFIELD("description", 4)
   SPEC<-1> = MAPFIELD("dependencies", 5)
   GOSUB GETPLAT
   BODY = HTTPGET(REG : "/package/" : FM : PLATQ)
   IF BODY = "" THEN META = "" ELSE META = JSONDECODE(BODY, SPEC)
   RETURN

* --- this client's platform as a registry query string ----------------
* PLATQ = "?system=<sys>&arch=<arch>" so the registry serves the matching
* prebuilt binary artifact; "" if undeterminable (registry serves source).
* Resolved once via the MVPKGOS seam and cached.
GETPLAT:
   IF PLATSET THEN RETURN
   PLATSET = 1
   PLATQ = ""
   CALL MVPKGOS("PLATFORM", "", "", PLAT)
   IF PLAT # "" AND INDEX(PLAT, ":", 1) THEN
      PSYS = FIELD(PLAT, ":", 1)
      POS = FIELD(PLAT, ":", 2)
      PARCH = FIELD(PLAT, ":", 3)
      PEND = FIELD(PLAT, ":", 4)
      IF PSYS # "" AND PARCH # "" THEN
         PLATQ = "?system=" : PSYS : "&arch=" : PARCH
         IF POS # "" THEN PLATQ := "&os=" : POS
         IF PEND # "" THEN PLATQ := "&endian=" : PEND
      END
   END
   RETURN

* --- MVPKG info <name> -------------------------------------------------
INFO:
   IF A1 = "" THEN PRINT "usage: MVPKG info <name>" ; RETURN
   FM = A1 ; GOSUB FETCHMETA
   IF META = "" THEN PRINT A1 : ": not found in registry " : REG ; RETURN
   PRINT "name:         " : META<1>
   PRINT "version:      " : META<2>
   PRINT "description:  " : META<4>
   PRINT "dependencies: " : META<5>
   PRINT "tarball:      " : REG : META<3>
   RETURN

* --- MVPKG list -------------------------------------------------------
* Show the packages MVPKG manages on this system — the global store manifest
* ("name version" per line), which install and register both write.
LIST:
   CALL MVPKGOS("STORE", "", "", STORE)
   GMAN = STORE : "/installed"
   OSREAD GTEXT FROM GMAN ELSE GTEXT = ""
   NG = 0
   FOR GI = 1 TO DCOUNT(GTEXT, CHAR(10))
      IF TRIM(FIELD(GTEXT, CHAR(10), GI)) # "" THEN NG = NG + 1
   NEXT GI
   IF NG = 0 THEN PRINT "no packages installed" ; RETURN
   PRINT "installed packages:"
   FOR GI = 1 TO DCOUNT(GTEXT, CHAR(10))
      LN = TRIM(FIELD(GTEXT, CHAR(10), GI))
      IF LN # "" THEN PRINT "  " : LN
   NEXT GI
   RETURN

* --- MVPKG register <name> [<version>] --------------------------------
* Record an ALREADY-installed package (e.g. one installed standalone before
* MVPKG was present) as installed, so MVPKG manages it: it is not reinstalled
* as another package's dependency, and a later `MVPKG install <name>` of the
* SAME version is a no-op (a newer version still upgrades).  Marks the global
* store manifest ("name version") and this account's manifest ("name"); it does
* NOT download or build anything — the package is assumed already present.
REGISTER:
   IF A1 = "" THEN PRINT "usage: MVPKG register <name> [<version>]" ; RETURN
   FM = A1 ; GOSUB FETCHMETA
   IF META = "" THEN PRINT A1 : ": not found in registry " : REG ; RETURN
   NM = META<1>
   VER = A2 ; IF VER = "" THEN VER = META<2>
   * global store manifest: "name version"
   CALL MVPKGOS("STORE", "", "", STORE)
   GMAN = STORE : "/installed"
   OSREAD GTEXT FROM GMAN ELSE GTEXT = ""
   GKEY = NM : " " : VER
   FND = 0
   FOR GI = 1 TO DCOUNT(GTEXT, CHAR(10))
      IF TRIM(FIELD(GTEXT, CHAR(10), GI)) = GKEY THEN FND = 1
   NEXT GI
   IF FND = 0 THEN
      IF GTEXT # "" AND GTEXT[LEN(GTEXT), 1] # CHAR(10) THEN GTEXT := CHAR(10)
      GTEXT := GKEY : CHAR(10)
      OSWRITE GTEXT ON GMAN
   END
   * account manifest: "name"
   OSREAD MTEXT FROM MFILE ELSE MTEXT = ""
   AFND = 0
   FOR I = 1 TO DCOUNT(MTEXT, CHAR(10))
      IF TRIM(FIELD(MTEXT, CHAR(10), I)) = NM THEN AFND = 1
   NEXT I
   IF AFND = 0 THEN
      IF MTEXT # "" AND MTEXT[LEN(MTEXT), 1] # CHAR(10) THEN MTEXT := CHAR(10)
      MTEXT := NM : CHAR(10)
      OSWRITE MTEXT ON MFILE
   END
   PRINT "registered " : NM : " " : VER : " (managed by MVPKG)"
   RETURN

* --- MVPKG install <name> [<dest>] ------------------------------------
INSTALL:
   IF A1 = "" THEN GOSUB USAGE ; RETURN

   * packages already installed in this account (skip re-installing deps)
   OSREAD MTEXT FROM MFILE ELSE MTEXT = ""
   INSTALLED = ""
   FOR I = 1 TO DCOUNT(MTEXT, CHAR(10))
      LN = TRIM(FIELD(MTEXT, CHAR(10), I))
      IF LN # "" THEN INSTALLED<-1> = LN
   NEXT I

   * ---- phase 1: transitive closure; DEPSOF<i> parallels NEED<i> -------
   NEED = A1
   DEPSOF = ""
   K = 1
   LOOP WHILE K <= DCOUNT(NEED, @AM) DO
      FM = NEED<K> ; GOSUB FETCHMETA
      IF META = "" THEN PRINT NEED<K> : ": not found in registry " : REG ; RETURN
      DEPSOF<K> = META<5>
      FOR J = 1 TO DCOUNT(META<5>, " ")
         D = FIELD(META<5>, " ", J)
         IF D # "" THEN
            SEEN = 0
            FOR X = 1 TO DCOUNT(NEED, @AM)
               IF NEED<X> = D THEN SEEN = 1
            NEXT X
            IF SEEN = 0 THEN NEED<-1> = D
         END
      NEXT J
      K = K + 1
   REPEAT

   * ---- phase 2: install deps-first (topological) ---------------------
   NP = DCOUNT(NEED, @AM)
   DONE = 0
   LOOP UNTIL DONE DO
      PROGRESS = 0 ; PENDING = 0
      FOR I = 1 TO NP
         P = NEED<I>
         DONEP = 0
         FOR X = 1 TO DCOUNT(INSTALLED, @AM)
            IF INSTALLED<X> = P THEN DONEP = 1
         NEXT X
         IF DONEP = 0 THEN
            PENDING = PENDING + 1
            READY = 1
            FOR J = 1 TO DCOUNT(DEPSOF<I>, " ")
               D = FIELD(DEPSOF<I>, " ", J)
               IF D # "" THEN
                  HAVE = 0
                  FOR X = 1 TO DCOUNT(INSTALLED, @AM)
                     IF INSTALLED<X> = D THEN HAVE = 1
                  NEXT X
                  IF HAVE = 0 THEN READY = 0
               END
            NEXT J
            IF READY THEN
               IF P = A1 AND A2 # "" THEN THISDEST = A2 ELSE THISDEST = P
               FM = P ; GOSUB FETCHMETA
               GOSUB DOINSTALL
               INSTALLED<-1> = P
               PROGRESS = 1
            END
         END
      NEXT I
      IF PENDING = 0 THEN DONE = 1
      IF PROGRESS = 0 AND PENDING > 0 THEN
         PRINT "mvpkg: cannot resolve dependencies (cycle or missing)"
         DONE = 1
      END
   REPEAT

   * persist the manifest
   MTEXT = ""
   FOR I = 1 TO DCOUNT(INSTALLED, @AM)
      MTEXT := INSTALLED<I> : CHAR(10)
   NEXT I
   OSWRITE MTEXT ON MFILE
   RETURN

* --- install one package: FM = name, META fetched --------------------------
* Two tiers.  GLOBAL (once per system): download the source into the store,
* globally catalog its code, record it in the store manifest.  ACCOUNT (every
* run): deploy the verbs + files into the current account.  So `MVPKG install`
* rerun in another account downloads nothing — it just links the package up.
DOINSTALL:
   CALL MVPKGOS("STORE", "", "", STORE)
   PKGKEY = CHANGE(META<1>, "/", "_")
   DEST = STORE : "/" : PKGKEY
   GMAN = STORE : "/installed"
   GKEY = META<1> : " " : META<2>
   OSREAD GTEXT FROM GMAN ELSE GTEXT = ""
   GINST = 0
   NG = DCOUNT(GTEXT, CHAR(10))
   FOR GI = 1 TO NG
      IF TRIM(FIELD(GTEXT, CHAR(10), GI)) = GKEY THEN GINST = 1
   NEXT GI
   IF GINST = 0 THEN
      TMP = "/tmp/mvpkg_" : PKGKEY : ".tar.gz"
      PRINT "fetching " : META<1> : " " : META<2> : " ..."
      * registry-hosted (relative) or an external http(s) URL (a binary-only
      * package served from a vendor site or GitHub) — absolute is used as-is.
      TURL = META<3>
      IF TURL[1, 4] # "http" THEN TURL = REG : TURL
      ST = HTTPGETFILE(TURL, TMP)
      IF ST < 200 OR ST >= 300 THEN PRINT "download failed (status " : ST : ")" ; RETURN
      EXECUTE '!rm -rf "' : DEST : '"'
      CALL MVPKGOS("UNTAR", TMP, DEST, ERR)
      IF ERR # "" THEN PRINT ERR ; RETURN
      EXECUTE '!rm -f ' : TMP
      CALL MVPKGOS("CALLC", DEST, META<1>, ERR)
      IF ERR # "" THEN PRINT ERR
      GOSUB PARSEDEPLOY
      GOSUB CATGLOBAL
      IF GTEXT # "" AND GTEXT[LEN(GTEXT), 1] # CHAR(10) THEN GTEXT := CHAR(10)
      GTEXT := GKEY : CHAR(10)
      OSWRITE GTEXT ON GMAN
      PRINT "installed " : META<1> : " " : META<2> : " (globally cataloged)"
   END ELSE
      GOSUB PARSEDEPLOY
      PRINT META<1> : " " : META<2> : " already installed — deploying here"
   END
   GOSUB DEPLOYACCT
   RETURN

* --- flatten the mvpkg.json "deploy" block in BASIC (no shell/python) -------
* MVPKGDEP walks the nested block (the flat JSON seam only reads flat strings),
* yielding space-separated DVERBS, DFILES ("name:type"), DFALL ("dep:dir").
PARSEDEPLOY:
   OSREAD MJ FROM DEST : "/mvpkg.json" ELSE MJ = ""
   CALL MVPKGDEP(MJ, DVERBS, DFILES, DFALL)
   RETURN

* --- GLOBAL: compile + globally catalog the code (once per system) ----------
CATGLOBAL:
   PRINT "cataloging " : META<1> : " ..."
   CALL MVPKGOS("CATALOG", DEST, "BP", ERR) ; IF ERR # "" THEN PRINT ERR
   * fallback dirs: catalog each only when its programs aren't already there.
   NF = DCOUNT(DFALL, " ")
   FOR I = 1 TO NF
      PR = FIELD(DFALL, " ", I)
      FBD = FIELD(PR, ":", 2)
      IF FBD # "" THEN CALL MVPKGOS("CATIFNEW", DEST, FBD, ERR)
   NEXT I
   RETURN

* --- ACCOUNT: deploy the verbs + files into the current account -------------
DEPLOYACCT:
   NV = DCOUNT(DVERBS, " ")
   FOR I = 1 TO NV
      V = FIELD(DVERBS, " ", I)
      IF V # "" THEN CALL MVPKGOS("VERB", V, "", ERR) ; IF ERR # "" THEN PRINT ERR
   NEXT I
   NFI = DCOUNT(DFILES, " ")
   FOR I = 1 TO NFI
      FT = FIELD(DFILES, " ", I)
      IF FT # "" THEN
         FNM = FIELD(FT, ":", 1) ; FTY = FIELD(FT, ":", 2)
         CALL MVPKGOS("MKFILE", FNM, FTY, ERR)
      END
   NEXT I
   PRINT "deployed " : META<1> : " into this account"
   RETURN

USAGE:
   PRINT "usage:"
   PRINT "  MVPKG install <name> [<dest>]"
   PRINT "  MVPKG info <name>"
   PRINT "  MVPKG list"
   PRINT "  MVPKG register <name> [<version>]"
   PRINT "  MVPKG config"
   RETURN
