* mv_package — MVPKG helper: is a package installed in the current account?
* (UniData port.)  Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* CALL MVPKG.HAS(NAME, FOUND) — FOUND = 1 if the package NAME is installed in
* this account (recorded in mvpkg.installed), else 0.  The runtime complement of
* an optional dependency: a package that declares "?other" guards its use of
* other at run time, so it works whether or not the optional add-on was present
* at install:
*
*    CALL MVPKG.HAS("mvx-lang/other", OK)
*    IF OK THEN GOSUB USE.OTHER ELSE GOSUB WITHOUT.OTHER
*
* NAME matches either the full registry name (owner/pkg) or the bare package
* name (after the last "/"), so both "cmd" and "mvx-lang/cmd" resolve.
   SUBROUTINE MVPKG.HAS(NAME, FOUND)
   FOUND = 0
   MFILE = "mvpkg.installed"
   OSREAD MTEXT FROM MFILE ELSE MTEXT = ""

   IN = NAME ; GOSUB BNAME ; WANTBN = BN
   NL = DCOUNT(MTEXT, CHAR(10))
   FOR I = 1 TO NL
      L = TRIM(FIELD(MTEXT, CHAR(10), I))
      IF L # "" THEN
         IF L = NAME THEN FOUND = 1
         IN = L ; GOSUB BNAME
         IF BN = WANTBN THEN FOUND = 1
      END
   NEXT I
   RETURN

* BN = the bare package name in IN: the field after the last "/".
BNAME:
   BN = FIELD(IN, "/", COUNT(IN, "/") + 1)
   RETURN
