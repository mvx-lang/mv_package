* mv_package — MVPKG subcommand: register (UniData port).
* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKG register <name> [<version>] — record an ALREADY-installed package
* (e.g. one installed standalone before MVPKG was present) as installed, so
* MVPKG manages it: it is not reinstalled as another package's dependency, and
* a later `MVPKG install <name>` of the SAME version is a no-op (a newer
* version still upgrades).  Marks the global store manifest ("name version")
* and this account's manifest ("name"); it does NOT download or build anything
* — the package is assumed already present.
   SUBROUTINE MVPKG.REGISTER
   S = @SENTENCE
   A1 = FIELD(S, " ", 3)
   A2 = FIELD(S, " ", 4)
   IF A1 = "" THEN PRINT "usage: MVPKG register <name> [<version>]" ; RETURN
   CALL MVPKG.REG(REG)
   CALL MVPKG.META(A1, "", REG, META)
   IF META = "" THEN PRINT A1 : ": not found in registry " : REG ; RETURN
   NM = META<1>
   VER = A2 ; IF VER = "" THEN VER = META<2>
   * system store inventory: add/update NM at version VER in MVPKG.STORE "installed"
   CALL MVPKGOS("STOREREAD", "installed", "", SREC)
   IF SREC = "" THEN SREC = "MVPKG-STORE"
   LOCATE(NM, SREC, 2; SPOS) THEN
      SREC<3,SPOS> = VER
   END ELSE
      SAN = DCOUNT(SREC<2>, @VM) + 1
      SREC<2,SAN> = NM
      SREC<3,SAN> = VER
   END
   CALL MVPKGOS("STOREWRITE", "installed", SREC, SERR)
   * account lock: the MVPKG.LOCK record (name in <2>, version in <3>)
   CALL MVPKGOS("MDREAD", "MVPKG.LOCK", "", IREC)
   AFND = 0
   FOR I = 1 TO DCOUNT(IREC<2>, @VM)
      IF TRIM(IREC<2,I>) = NM THEN AFND = 1 ; IREC<3,I> = VER   ;* refresh version
   NEXT I
   IF AFND = 0 THEN
      IF IREC = "" THEN IREC = "MVPKG-LOCK"
      AN = DCOUNT(IREC<2>, @VM) + 1
      IREC<2,AN> = NM
      IREC<3,AN> = VER
   END
   CALL MVPKGOS("MDWRITE", "MVPKG.LOCK", IREC, IERR)
   PRINT "registered " : NM : " " : VER : " (managed by MVPKG)"
   RETURN
