* Copyright (C) 2026 Gordon Heydon.  GPL-2.0-only (see LICENSE).
*
* MVPKGOS(OP, P1, P2, RESULT) — the one call the portable MVPKG client makes
* for operations that are not pure MultiValue.  This is the Rocket UniData
* port; it matches the MVX MVPKGOS (MKDIR / UNTAR) and adds the two ops that
* let the package manager maintain UniData's shared CallC library:
*
*   OP = "MKDIR"    P1 = path                 -> create P1 (and parents)
*   OP = "UNTAR"    P1 = tarball  P2 = destdir -> extract P1 into P2
*   OP = "CALLC"    P1 = pkgdir   P2 = name    -> stage the package's native
*                     CallC contribution (P1/udt-callc) and rebuild the
*                     shared libu2callc.so from every contribution installed;
*                     a package without a udt-callc/ is a silent no-op
*   OP = "REBUILD"                             -> rebuild the shared library
*                     from the currently-staged contributions (no install)
*   OP = "CATALOG"  P1 = pkgdir   P2 = subdir  -> compile every source item in
*                     P1/P2 in place and GLOBALLY catalog it (install)
*   OP = "CATIFNEW" P1 = pkgdir   P2 = subdir  -> CATALOG P2 only when its
*                     programs are not already cataloged (a package's fallback)
*   OP = "VERB"     P1 = verbname              -> deploy a per-account VOC
*                     pointer to a globally cataloged verb (deploy).  Global
*                     scope only — a "local" account's LOCAL catalog is itself
*                     the account verb, so the deploy skips this  (see CONF)
*   OP = "CONF"     P1 = "scope"|"prefix"      -> RESULT = this account's deploy
*                     config (catalog scope / store prefix), defaults applied
*   OP = "CONFSET"  P1 = scope  P2 = prefix    -> persist the deploy config
*                     (MVPKG init writes it; #34 test/live isolation)
*   OP = "STORE"                               -> RESULT = the global package
*                     store dir (created); download-once lives here
*   OP = "HAVE"     P1 = progname              -> RESULT "1"/"0": would CALL P1
*                     resolve (local VOC "C" or global catalog)? — for fallback
*   OP = "MKFILE"   P1 = name  P2 = type       -> create an account file if
*                     absent ("dir" or "" = dynamic) — deploy.files
*   OP = "MDREAD"   P1 = recid                 -> RESULT = the account master-
*                     dictionary record (VOC/MD), "" if absent — MVPKG keeps its
*                     manifest / lock / installed set as native MV records here
*   OP = "MDWRITE"  P1 = recid  P2 = record    -> write the account master-
*                     dictionary record
*   OP = "MDDELETE" P1 = recid                 -> delete the account record
*   OP = "PLATFORM"                            -> RESULT =
*                     "<system>:<os>:<arch>:<endian>", the identity the client
*                     sends the registry so it serves the matching prebuilt
*                     binary (else source).  UniData is system "udt"; os is
*                     uname -s (linux/aix/windows — native code is OS-locked);
*                     arch is uname -m; endian is "le"/"be" (the axis for BASIC
*                     objects + data files).
*
* UniData loads exactly one libu2callc.so, so native add-ons cannot each own
* it — they are aggregated.  The heavy lifting (compile, merge cfuncdef,
* gencdef/genefs/genfunc, relink, install) lives in the udt-callc-build
* helper, installed at $UDTHOME/bin/udt-callc-build by the mv_package
* UniData setup; MVPKGOS just drives it.  RESULT is "" on success or an
* error message.  These reach the OS through MVPKG.SH, so the caller
* needs the unrestricted privilege tier — installing software is privileged.
   SUBROUTINE MVPKGOS(OP, P1, P2, RESULT)
$INCLUDE MVPKG.INC PLATFORM.H
   RESULT = ""
   NFM = ""                               ;* NEWFILE's modulo, when a caller cares
   OP = OCONV(OP, "MCU")
* The root the shared package store hangs off.  On UniData that is $UDTHOME, a
* system location every operator account of the install can reach.  jBASE has no
* equivalent -- $JBCRELEASEDIR is the release tree and is not ours to write into
* -- so the store is per-user there.  Without this the default is "" and the
* store resolves to "/mvpkg", which is not writable and fails as a permission
* error a long way from the cause.
$IFDEF JBASE
   CALL MVPKG.ENV("HOME", UDT)
$ENDIF
$IFDEF UV
   CALL MVPKG.ENV("HOME", UDT)
$ENDIF
$IFDEF UDT
   CALL MVPKG.ENV("UDTHOME", UDT)
$ENDIF
   BUILDER = UDT : "/bin/udt-callc-build"
   GOSUB CONFLOAD                         ;* MSCOPE / MPREFIX (#34 test/live isolation)
   BEGIN CASE
      CASE OP = "MKDIR"
         CALL MVPKG.SH('mkdir -p "':P1:'"', MVSHOUT, MVSHST)
      CASE OP = "UNTAR"
         * Extract into P2.  Account-shaped packages wrap their tree in one named
         * top dir (e.g. git/); contents-at-root packages do not.  Count the
         * distinct top-level components and, when there is exactly one, strip it
         * so the package's files land at the store root either way.
         CALL MVPKG.SH('mkdir -p "':P2:'"; n=`tar -tzf "':P1:'" | sed "s#^\./##; s#/.*##" | grep -v "^$" | sort -u | wc -l | tr -d " "`; if [ "$n" = 1 ]; then tar -xzf "':P1:'" --strip-components=1 -C "':P2:'"; else tar -xzf "':P1:'" -C "':P2:'"; fi', MVSHOUT, MVSHST)
      CASE OP = "CALLC"
         * Fold P1's udt-callc contribution (named P2) into libu2callc.so.  A
         * package with no contribution is a no-op; a real one relinks and needs
         * gcc.  Capture the builder's exit (via a temp file, like PLATFORM) so a
         * failed link surfaces as an error the caller aborts on — not a silent
         * success that then catalogs verbs with no CallC backend behind them.
         TMPF = "/tmp/mvpkg_callc_" : @USERNO
         CALL MVPKG.SH('"':BUILDER:'" add "':P1:'" "':P2:'"; echo $? > "':TMPF:'"', MVSHOUT, MVSHST)
         CALL MVPKG.FILE("READ", TMPF, RC, MVFOK)
         IF NOT(MVFOK) THEN RC = "1"
         CALL MVPKG.SH('rm -f "':TMPF:'"', MVSHOUT, MVSHST)
         RC = TRIM(FIELD(FIELD(FIELD(RC, @AM, 1), CHAR(10), 1), CHAR(13), 1))
         IF RC # "0" THEN RESULT = "CallC build failed (udt-callc-build exit ":RC:") — see its output above (gcc / package -devel libs missing?)"
      CASE OP = "REBUILD"
         CALL MVPKG.SH('"':BUILDER:'"', MVSHOUT, MVSHST)
      CASE OP = "PLATFORM"
      * CONVERT() TAKES ITS ARGUMENTS IN THE OPPOSITE ORDER ON jBASE.  U2 and
      * MVX read CONVERT(from, to, expr); jBASE reads CONVERT(expr, from, to).
      * Measured on both: "Linux":CHAR(10) through the U2 spelling comes back
      * length 2 on jBASE and length 6 on MVX, and the other spelling does the
      * reverse -- so no argument order works on all four, and the call returns
      * rubbish rather than failing (mv_package#54).  FIELD says portably what
      * these actually want: the FIRST LINE of a shell capture.
         * "!" shell escapes don't feed CAPTURING here, so route the probes
         * through a temp file and read them back.  os = uname -s (linux/aix/
         * windows — native objects are OS-locked); arch = uname -m; endian
         * from a two-byte dump (0201 = little, 0102 = big — the axis for
         * compiled BASIC objects + data files).  RESULT =
         * "<sys>:<os>:<arch>:<endian>".
         TMPF = "/tmp/mvpkg_plat_" : @USERNO
         CALL MVPKG.SH('uname -s > "':TMPF:'" 2>/dev/null', MVSHOUT, MVSHST)
         CALL MVPKG.FILE("READ", TMPF, OSN, MVFOK)
         OSN = OCONV(TRIM(FIELD(FIELD(FIELD(OSN, @AM, 1), CHAR(10), 1), CHAR(13), 1)), "MCL")
         BEGIN CASE
            CASE INDEX(OSN, "linux", 1) ; OSN = "linux"
            CASE INDEX(OSN, "aix", 1)   ; OSN = "aix"
            CASE INDEX(OSN, "sunos", 1) ; OSN = "solaris"
            CASE INDEX(OSN, "hp-ux", 1) ; OSN = "hpux"
            CASE INDEX(OSN, "windows", 1) OR INDEX(OSN, "cygwin", 1) OR INDEX(OSN, "mingw", 1) ; OSN = "windows"
            CASE OSN = "" ; OSN = "unknown"
         END CASE
         CALL MVPKG.SH('uname -m > "':TMPF:'" 2>/dev/null', MVSHOUT, MVSHST)
         CALL MVPKG.FILE("READ", TMPF, ARCH, MVFOK)
         ARCH = TRIM(FIELD(FIELD(FIELD(ARCH, @AM, 1), CHAR(10), 1), CHAR(13), 1))
         IF ARCH = "" THEN ARCH = "unknown"
         CALL MVPKG.SH("printf '\1\2' | od -An -tx2 | tr -d ' ' > " : TMPF : " 2>/dev/null", MVSHOUT, MVSHST)
         CALL MVPKG.FILE("READ", TMPF, EW, MVFOK)
         CALL MVPKG.SH('rm -f "':TMPF:'"', MVSHOUT, MVSHST)
         IF EW[1,4] = "0102" THEN ENDIAN = "be" ELSE ENDIAN = "le"
         * THE SYSTEM IS NOT ALWAYS udt.  These sources are shared by udt, uv
         * and jbase, and this named one of them -- so jBASE asked the registry
         * for UniData artifacts.  It went unnoticed because the arch was empty
         * (the CONVERT above), and the query is only sent when system AND arch
         * are both set (mv_package#54).
         SYS = "udt"
$IFDEF UV
         SYS = "uv"
$ENDIF
$IFDEF JBASE
         SYS = "jbase"
$ENDIF
         RESULT = SYS : ":" : OSN : ":" : ARCH : ":" : ENDIAN
      CASE OP = "CATALOG"
         * P1 = package dir, P2 = source subdir (e.g. "BP").  Compile every
         * source item in P1/P2 in place — via a temp VOC DIR-pointer, so
         * nothing is copied — and GLOBALLY catalog it, so its subroutines are
         * callable and its verbs cataloged for any account.  CATALOG FORCE
         * overwrites, so re-installing a package updates the shared copy.
         SDIR = P1 : "/" : P2
         GOSUB LISTSRC
         GOSUB DOCAT
      CASE OP = "CATIFNEW"
         * P1 = package dir, P2 = subdir.  Catalog it only when its programs
         * are NOT already cataloged — the fallback: a bundled copy (git's
         * CMD.BP) is cataloged just when the real dependency is absent.
         SDIR = P1 : "/" : P2
         GOSUB LISTSRC
         HAV = "0"
         IF DCOUNT(ITEMS, @AM) > 0 THEN NCK = ITEMS<1> ; GOSUB HAVECHK
         IF HAV = "0" THEN GOSUB DOCAT ELSE GOSUB DROPPTR
      CASE OP = "VERB"
         * P1 = verb name.  Deploy a per-account VOC pointer to the globally
         * cataloged object so the verb is typeable in THIS account (a global
         * object alone is not a verb).  Subroutines need no such entry.
         GOBJ = UDT : "/sys/CTLG/" : OCONV(P1[1,1], "MCL") : "/" : P1
         OPEN MVMASTER TO VVF ELSE RESULT = "MVPKGOS VERB: cannot open " : MVMASTER ; RETURN
         WRITE ("C" : @FM : GOBJ : @FM : "mvpkg " : P1) ON VVF, P1
      CASE OP = "STORE"
         * RESULT = the global package store (created if absent) — where a
         * downloaded package's source lives once per system so it can be
         * globally cataloged and deployed to any account.  $MVPKG_STORE
         * overrides the default $UDTHOME/mvpkg.
         CALL MVPKG.ENV("MVPKG_STORE", SP)
         IF SP = "" THEN SP = UDT : "/" : MPREFIX : "mvpkg"
         CALL MVPKG.SH('mkdir -p "' : SP : '"', MVSHOUT, MVSHST)
         RESULT = SP
      CASE OP = "HAVE"
         * P1 = program name.  RESULT = "1" if CALL P1 would resolve (a local
         * VOC "C" catalog pointer OR the global catalog file), else "0" — the
         * MV catalog-lookup idiom, mirroring how CALL resolves.  Used to honor
         * a package's "fallback" (bundle a copy only when the dep is absent).
         NCK = P1 ; GOSUB HAVECHK ; RESULT = HAV
      CASE OP = "MKFILE"
         * P1 = file name, P2 = type ("dir" = a directory file, one that holds
         * source items like BP; anything else = a hashed file).  Create it in
         * this account if absent (deploy.files); a no-op if it already opens.
         * NEWFILE knows how each platform is asked for one.
         OPEN P1 TO MFF THEN
            RESULT = ""
         END ELSE
            NFN = P1 ; NFT = P2 ; GOSUB NEWFILE
         END
      CASE OP = "MDREAD"
         * Read a record from the account master dictionary — the portable home
         * for account state (VOC on UniData/UniVerse, MD on D3).  P1 = record id;
         * RESULT = the record (a dynamic array), or "" when it is not on file.
         * This is how MVPKG keeps its manifest / lock / installed set the Pick
         * way — native MV records, not OS-level files.
         OPEN MVMASTER TO MDF ELSE RESULT = "" ; RETURN
         READ MDR FROM MDF, P1 THEN RESULT = MDR ELSE RESULT = ""
      CASE OP = "MDWRITE"
         * P1 = record id, P2 = the record (a dynamic array).  Persist account
         * state as a native master-dictionary record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDWRITE: cannot open " : MVMASTER ; RETURN
         WRITE P2 ON MDF, P1
      CASE OP = "MDDELETE"
         * P1 = record id.  Remove an account state record.
         OPEN MVMASTER TO MDF ELSE RESULT = "MVPKGOS MDDELETE: cannot open " : MVMASTER ; RETURN
         DELETE MDF, P1
      CASE OP = "STOREREAD"
         * Read a record from the shared SYSTEM store file MVPKG.STORE — the
         * per-system inventory of installed packages (record "installed": <2>
         * names / <3> versions; "SRC.<key>": a source working-copy path).  The
         * file lives in the operator account; other accounts reach it through a
         * VOC pointer the seam adds (STOREHEAL).  P1 = record id; RESULT = the
         * record, or "" when absent.
         GOSUB STOREOPEN
         RESULT = ""
         IF STFOK THEN READ SREC FROM STF, P1 THEN RESULT = SREC
      CASE OP = "STOREWRITE"
         * P1 = record id, P2 = the record.  Persist the system inventory.
         GOSUB STOREOPEN
         IF STFOK THEN WRITE P2 ON STF, P1 ELSE RESULT = "MVPKGOS STOREWRITE: cannot open MVPKG.STORE"
      CASE OP = "STOREDELETE"
         * P1 = record id.  Remove a system-inventory record.
         GOSUB STOREOPEN
         IF STFOK THEN DELETE STF, P1
      CASE OP = "DECAT"
         * P1 = package dir, P2 = source subdir.  The inverse of CATALOG: remove
         * every program's global catalog entry so it no longer resolves.
         SDIR = P1 : "/" : P2
         GOSUB LISTSRC
         GOSUB DODECAT
      CASE OP = "UNVERB"
         * P1 = verb name.  Remove this account's VOC pointer for the verb
         * (the inverse of VERB).
         OPEN MVMASTER TO VVF ELSE RESULT = "MVPKGOS UNVERB: cannot open " : MVMASTER ; RETURN
         DELETE VVF, P1
      CASE OP = "CALLCRM"
         * P1 = package key (name '/'->'_').  Unstage its CallC contribution and
         * rebuild libu2callc.so from what remains (the inverse of CALLC).
         CALL MVPKG.SH('"':BUILDER:'" remove "':P1:'"', MVSHOUT, MVSHST)
      CASE OP = "RMDIR"
         * P1 = directory.  Remove it (the store copy on uninstall).
         CALL MVPKG.SH('rm -rf "':P1:'"', MVSHOUT, MVSHST)
      CASE OP = "CHOWN"
         * P1 = path, P2 = user (or user:group).  Hand ownership to the operator —
         * repair a root-owned install so MVPKG can catalog/upgrade again, or move
         * the install to a new operator.  Needs sudo ($UDTHOME/sys/CTLG + the CallC
         * library are DBA-owned).  Recursive, so a dir + its records go together; a
         * missing path is silently skipped (2>/dev/null).  FIXPERMS drives it.
         IF P1 # "" AND P2 # "" THEN CALL MVPKG.SH('sudo chown -R "' : P2 : '" "' : P1 : '" 2>/dev/null', MVSHOUT, MVSHST)
      CASE OP = "INCSETUP"
         * Create the MVPKG.INC directory file (+ its VOC pointer) and write the
         * PLATFORM.H record with the UniData platform defines, so a managed
         * package can $INCLUDE MVPKG.INC PLATFORM.H.  Idempotent — CREATE.FILE on
         * an existing file is captured and ignored.
$IFDEF JBASE
* jBASE resolves $INCLUDE by directory layout, so MVPKG.INC is an ordinary
* directory here and PLATFORM.H an ordinary file in it -- no file pointer, and
* no CREATE.FILE.  Which is just as well: `CREATE.FILE DIR MVPKG.INC` reads DIR
* as the file NAME on jBASE rather than the type, so it silently creates a file
* called DIR and never makes the one asked for.
*
* AND THE CONTENT HAS TO BE THIS PLATFORM'S.  Writing the UniData header here
* would overwrite the account's own PLATFORM.H with $DEFINE UDT, and every
* later recompile would quietly take the UniData arm of every guard -- an
* account broken by its own `MVPKG init`.
         CALL MVPKG.SH('mkdir -p "' : @PATH : '/MVPKG.INC"', MVSHOUT, MVSHST)
         PH = "* PLATFORM.H - jBASE platform defines."
         PH<-1> = "* GENERATED FILE - DO NOT EDIT.  MVPKG INIT rewrites it,"
         PH<-1> = "* so any change made here is lost the next time it runs."
         PH<-1> = "$DEFINE MV"
         PH<-1> = "$DEFINE JBASE"
         PH<-1> = 'EQUATE MVMASTER TO "MD"'
         CALL MVPKG.FILE("WRITE", @PATH : "/MVPKG.INC/PLATFORM.H", PH, MVFOK)
$ENDIF
$IFDEF UV
* Same shape as UniData -- a directory file and a record in it -- but the header
* has to say UV, or `MVPKG init` rewrites the account as a UniData one and every
* later recompile takes the wrong arm of every guard.
*
* The file is made through NEWFILE rather than `CREATE.FILE DIR MVPKG.INC`,
* which is UniData's spelling: UniVerse reads that DIR as the MODULO, answers
* "Improper modulo number entered", and then asks the question -- and a
* question asked from inside EXECUTE is not an error, it is a hang.
         NFN = "MVPKG.INC" ; NFT = "dir" ; GOSUB NEWFILE
         OPEN "MVPKG.INC" TO INCF THEN
            PH = "* PLATFORM.H - UniVerse (UV) platform defines."
            PH<-1> = "* GENERATED FILE - DO NOT EDIT.  MVPKG INIT rewrites it,"
            PH<-1> = "* so any change made here is lost the next time it runs."
            PH<-1> = "$DEFINE MV"
            PH<-1> = "$DEFINE UV"
            PH<-1> = 'EQUATE MVMASTER TO "VOC"'
            WRITE PH ON INCF, "PLATFORM.H"
         END ELSE
            RESULT = "MVPKGOS INCSETUP: cannot open MVPKG.INC"
         END
$ENDIF
$IFDEF UDT
         EXECUTE "CREATE.FILE DIR MVPKG.INC" CAPTURING JUNK
         OPEN "MVPKG.INC" TO INCF THEN
            PH = "* PLATFORM.H - UniData (UDT) platform defines."
            PH<-1> = "* GENERATED FILE - DO NOT EDIT.  MVPKG INIT rewrites it,"
            PH<-1> = "* so any change made here is lost the next time it runs."
            PH<-1> = "$DEFINE MV"
            PH<-1> = "$DEFINE UDT"
            * MVMASTER names the account's master dictionary -- see the mvx arm.
            PH<-1> = 'EQUATE MVMASTER TO "VOC"'
            WRITE PH ON INCF, "PLATFORM.H"
         END ELSE
            RESULT = "MVPKGOS INCSETUP: cannot open MVPKG.INC"
         END
$ENDIF
      CASE OP = "CONF"
         * P1 = field ("scope" | "prefix").  RESULT = this account's deploy config
         * value (loaded by CONFLOAD, with defaults).  The portable client reads
         * the catalog scope through this so it deploys/undeploys consistently.
         BEGIN CASE
            CASE OCONV(P1, "MCL") = "scope"  ; RESULT = MSCOPE
            CASE OCONV(P1, "MCL") = "prefix" ; RESULT = MPREFIX
            CASE 1                           ; RESULT = ""
         END CASE
      CASE OP = "CONFSET"
         * P1 = catalog scope ("global"|"local"), P2 = account prefix.  Persist the
         * per-account deploy config (MVPKG init writes it).  An empty scope keeps
         * the default "global".
         CSC = OCONV(TRIM(P1), "MCL") ; IF CSC # "local" THEN CSC = "global"
         CREC = "MVPKG-CONF" ; CREC<2> = CSC ; CREC<3> = TRIM(P2)
         OPEN MVMASTER TO CFW ELSE RESULT = "MVPKGOS CONFSET: cannot open " : MVMASTER ; RETURN
         WRITE CREC ON CFW, "MVPKG.CONF"
      CASE 1
         RESULT = "MVPKGOS: unknown op ":OP
   END CASE
   RETURN

* --- shared helpers (reached by GOSUB) --------------------------------------
* SDIR set: make a temp VOC DIR-pointer to it and list its source items
* (skipping compiled _objects and dotfiles) natively via SELECT — no shell.
LISTSRC:
   ITEMS = ""
   OPEN MVMASTER TO LVF ELSE RESULT = "MVPKGOS: cannot open " : MVMASTER ; RETURN
* A FILE POINTER'S TYPE IS SPELLED DIFFERENTLY HERE.  UniData and jBASE write
* "DIR" in attribute 1; UniVerse writes "F" and rejects "DIR", so the OPEN below
* just fails and not one package can be cataloged.  Read one of UniVerse's own
* pointers back (CT VOC BP) and it says "F", with the file description after it.
   PTYPE = "DIR"
$IFDEF UV
   PTYPE = "F"
* AND UNIVERSE DOES NOT PUT OBJECTS BESIDE THE SOURCE.  It compiles <dir>/<prog>
* to <dir>.O/<prog>, making the pointer to that object directory itself -- but
* not the OS directory behind it.  Without this the compile stops at "[ENOENT]
* No such file or directory" having built nothing.
   CALL MVPKG.SH('mkdir -p "' : SDIR : '.O"', MVSHOUT, MVSHST)
$ENDIF
   WRITE (PTYPE : @FM : SDIR : @FM : "D_BP") ON LVF, "MVPKG.SRC"
   OPEN "MVPKG.SRC" TO LSF ELSE RESULT = "MVPKGOS: cannot open " : SDIR ; RETURN
   SELECT LSF TO LLIST
   RDONE = 0
   LOOP UNTIL RDONE DO
      READNEXT ID FROM LLIST THEN
         * A program contributes its name whether it is present as source (ID)
         * or only as a prebuilt object (_ID — a binary package); dotfiles are
         * skipped.  Dedup so source+object side by side list the program once.
         BEGIN CASE
            CASE ID[1,1] = "."   ; PROG = ""
            CASE ID[1,1] = "_"   ; PROG = ID[2, LEN(ID) - 1]
            CASE 1               ; PROG = ID
         END CASE
         IF PROG # "" THEN
            LOCATE(PROG, ITEMS; DUMP) ELSE ITEMS<-1> = PROG
         END
      END ELSE RDONE = 1
   REPEAT
   RETURN

* compile + globally catalog every listed item (via the pointer), then drop it.
* A binary package ships prebuilt _objects: compile only the items that lack
* one (a source install), then catalog every item either way — so a udt binary
* artifact installs with no compiler, while a source package still compiles.
DOCAT:
   NI = DCOUNT(ITEMS, @AM)
   IF NI > 0 THEN
      NEEDBAS = ""
      FOR CI = 1 TO NI
         OBJID = "_" : ITEMS<CI>
         READ OBJREC FROM LSF, OBJID THEN
            HASOBJ = 1
         END ELSE
            NEEDBAS := ITEMS<CI> : " "
         END
      NEXT CI
      IF NEEDBAS # "" THEN EXECUTE "BASIC MVPKG.SRC " : NEEDBAS
      * #34 scope: a "local" account catalogs into its OWN catalog (CATALOG ...
      * LOCAL), so a test build never overwrites the live global catalog — and
      * LOCAL cataloging also registers each program as a verb in THIS account, so
      * the deploy needs no separate VOC pointer step.  "global" (default) catalogs
      * system-wide, as before.
      LOC = "" ; IF MSCOPE = "local" THEN LOC = "LOCAL "
      FOR CI = 1 TO NI ; EXECUTE "CATALOG MVPKG.SRC " : ITEMS<CI> : " " : LOC : "FORCE" ; NEXT CI
   END
   GOSUB DROPPTR
   RETURN

* decatalog every listed program (remove its global catalog entry), then drop
* the temp pointer.  The inverse of DOCAT.
DODECAT:
   * #34: plain DELETE.CATALOG resolves through THIS account's catalog view, so it
   * removes a local account's own LOCAL entry (leaving any shared global copy
   * that a live env cataloged untouched) and a global account's global entry —
   * both scopes, one form.  A trailing LOCAL/GLOBAL keyword is a syntax error here.
   NI = DCOUNT(ITEMS, @AM)
   FOR CI = 1 TO NI
      EXECUTE "DELETE.CATALOG " : ITEMS<CI>
   NEXT CI
   GOSUB DROPPTR
   RETURN

DROPPTR:
   DELETE LVF, "MVPKG.SRC"
   RETURN

* NEWFILE -- create the account file NFN if it is not already there.  NFT is
* "dir" for a directory file (one that holds source items, like BP) and anything
* else for a hashed one; NFM is the modulo when the caller cares, else 1.
* Idempotent on every platform: creating a file that already exists leaves it,
* and its records, alone.
NEWFILE:
   IF NFM = "" THEN NFM = 1
$IFNDEF UV
   IF OCONV(NFT, "MCL") = "dir" THEN
      CALL MVPKG.SH('mkdir -p "' : NFN : '" "D_' : NFN : '"', MVSHOUT, MVSHST)
      OPEN MVMASTER TO NFV ELSE RESULT = "MVPKGOS NEWFILE: cannot open " : MVMASTER ; RETURN
      WRITE ("DIR" : @FM : NFN : @FM : "D_" : NFN) ON NFV, NFN
   END ELSE
      EXECUTE "CREATE.FILE " : NFN : " " : NFM
   END
$ENDIF
$IFDEF UV
* UNIVERSE ASKS SEVEN QUESTIONS AND NO ARGUMENT FORM ANSWERS THEM.  `CREATE.FILE
* X 19` reads the 19 as a MODULO, not a type, and every other positional
* spelling either mis-parses or leaves the DATA part unspecified.  The verb then
* stops on "Modulo =" -- which, from inside EXECUTE, is a hang and not an error.
* So the answers go on the input stack instead: modulo, separation and type for
* the DICTionary, the same three for the DATA part, then a FILE DESCRIPTION.
*
* THE EMPTY DESCRIPTION IS NOT PADDING.  UniVerse keeps it in VOC attribute 1 as
* "F <description>", so anything that tests attribute 1 for "F" -- LISTSRC's
* pointer, an account scan -- stops seeing the file the moment it carries one.
*
* Types 18 (hashed) and 19 (directory), NOT 30: UniVerse rejects 30, re-prompts,
* and the re-prompt eats the rest of the stack, so the file is never made and
* the leftovers are inherited by whatever EXECUTEs next.  CLEARDATA closes that
* door for the case where a create consumes fewer answers than it was handed.
   IF OCONV(NFT, "MCL") = "dir" THEN
      DATA 1, 2, 3, NFM, 2, 19, ""
   END ELSE
      DATA 1, 2, 3, NFM, 2, 18, ""
   END
   EXECUTE "CREATE.FILE " : NFN CAPTURING NFJUNK
   CLEARDATA
$ENDIF
   NFM = ""
   RETURN

* CONFLOAD — this account's deploy config (MVPKG.CONF), read once per call into
* MSCOPE / MPREFIX with defaults, so CATALOG / DECAT pick the right catalog scope
* and STORE resolves the right (prefixed) store.  Absent record = defaults:
* global catalog, no prefix — the production behaviour, unchanged.   [#34]
CONFLOAD:
   MSCOPE = "global" ; MPREFIX = ""
   OPEN MVMASTER TO CLVF THEN
      READ CLR FROM CLVF, "MVPKG.CONF" THEN
         IF OCONV(TRIM(CLR<2>), "MCL") = "local" THEN MSCOPE = "local"
         MPREFIX = TRIM(CLR<3>)
      END
   END
   RETURN

* HAV = "1" if CALL NCK would resolve (a local VOC "C" pointer or the global
* catalog file), else "0".
HAVECHK:
   HAV = "0"
* THE CATALOG POINTER IS NOT ALWAYS TYPE "C".  UniData writes "C"; UniVerse's
* LOCAL catalog writes "V" with the object path in attribute 2 -- and it is that
* record which makes the program both typeable and CALLable.  Reading only "C"
* here made every HAVE answer "0" on UniVerse, so a package with a "fallback"
* bundled its own copy of a dependency that was installed and working.
   CTYPES = "C"
$IFDEF UV
   CTYPES = "C":@AM:"V"
$ENDIF
   OPEN MVMASTER TO HVF THEN
      READ HR FROM HVF, NCK THEN
         LOCATE(HR<1>, CTYPES; CTPOS) THEN HAV = "1"
      END
   END
   IF HAV = "0" THEN
      GP = UDT : "/sys/CTLG/" : OCONV(NCK[1,1], "MCL") : "/" : NCK
      OPENSEQ GP TO HSF THEN HAV = "1" ; CLOSESEQ HSF
   END
   RETURN

* STOREOPEN — open the shared system store file MVPKG.STORE, self-healing the
* account's access first if it does not open.  STFOK = 1 when STF is usable.
STOREOPEN:
   STFOK = 0
   OPEN "MVPKG.STORE" TO STF THEN
      STFOK = 1
   END ELSE
      GOSUB STOREHEAL
      OPEN "MVPKG.STORE" TO STF THEN STFOK = 1
   END
   RETURN

* STOREHEAL — make MVPKG.STORE reachable from this account.  The store's OS dir
* ($MVPKG_STORE or $UDTHOME/mvpkg) carries an "operator" marker: <line1> the
* owning account's UD.ACCOUNT name, <line2> its @PATH.  First use ever: this
* account becomes the owner (create the file + write the marker).  The owner with
* a missing file: recreate it.  Any other account: add a VOC Q-pointer to the
* owner's copy by account name (the operator account is registered in UD.ACCOUNT).
* Deploying MVPKG to a NEW account therefore sets this pointer up automatically,
* not just the cataloging of programs.
STOREHEAL:
   CALL MVPKG.ENV("MVPKG_STORE", SP)
   IF SP = "" THEN SP = UDT : "/" : MPREFIX : "mvpkg"
   OMARK = SP : "/operator"
   CALL MVPKG.FILE("READ", OMARK, OINFO, MVFOK)
   ONAME = TRIM(FIELD(OINFO, CHAR(10), 1))
   OPATH = TRIM(FIELD(OINFO, CHAR(10), 2))
   MYPATH = @PATH
   MYNAME = FIELD(MYPATH, "/", DCOUNT(MYPATH, "/"))   ;* account name = dir basename
   BEGIN CASE
      CASE OINFO = ""
         NFN = "MVPKG.STORE" ; NFT = "" ; NFM = 7 ; GOSUB NEWFILE
         CALL MVPKG.FILE("WRITE", OMARK, MYNAME : CHAR(10) : MYPATH, MVFOK)
      CASE OPATH = MYPATH
         NFN = "MVPKG.STORE" ; NFT = "" ; NFM = 7 ; GOSUB NEWFILE
      CASE 1
         OPEN MVMASTER TO SVF THEN
            WRITE ("Q" : @FM : ONAME : @FM : "MVPKG.STORE") ON SVF, "MVPKG.STORE"
         END
   END CASE
   RETURN
